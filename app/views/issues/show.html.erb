<% content_for :title, "#{@broadcast.issue_title} — #{site_settings.site_name}" %>
<% sent_on = (@broadcast.sent_at || @broadcast.issued_at).to_date %>

<article class="press-shell press-body u-full-width u-flow">
  <header class="u-flow-half">
    <p class="press-meta">
      Sent <time datetime="<%= sent_on.iso8601 %>"><%= sent_on.strftime("%B %-d, %Y") %></time>
      <% if @broadcast.sent? %>to <%= number_with_delimiter(@broadcast.recipients_count) %> <%= "subscriber".pluralize(@broadcast.recipients_count) %><% end %>
      · <%= site_settings.site_name %> newsletter
    </p>
    <h1 class="press-display-lg"><%= @broadcast.issue_title %></h1>
  </header>

  <%= frozen_issue(@broadcast) %>
</article>
