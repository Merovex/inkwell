<% content_for :title, "Create your site — Inkwell" %>

<div class="card auth__card">
  <header class="card__header"><span class="card__title">Create your site</span></header>
  <div class="card__body u-stack">
    <p class="u-text-muted">Name your site. This becomes your public site's name — you can change how it appears later in settings.</p>

    <%= render "admin/shared/error_summary", model: @account %>

    <%= form_with model: @account, url: accounts_path, class: "field" do |f| %>
      <%= f.label :name, "Site name", class: "field__label" %>
      <%= f.text_field :name, class: "field__control", placeholder: "Merovex Press", required: true, autofocus: true, autocomplete: "off" %>
      <div class="form__action">
        <%= f.submit "Create site", class: "button button--primary u-full-width" %>
      </div>
    <% end %>
  </div>
</div>
