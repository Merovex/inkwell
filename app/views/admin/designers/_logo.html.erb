<%# The custom-logo slot: replaces the site title in the header. The drop
    zone holds only the upload affordances (thumb + buttons + drag hint);
    the title-as-alt choice sits below it. Persists to the Site immediately
    — images can't ride the localStorage lab. %>
<% site = Current.account.site %>
<section class="designer__block" aria-label="Custom logo">
  <h3 class="designer__block-title">Custom logo</h3>
  <div class="designer__dropzone" data-designer-target="logoDropzone"
       data-action="dragover->designer#logoDragOver dragleave->designer#logoDragLeave drop->designer#logoDrop">
    <img class="designer__logo-thumb" data-designer-target="logoThumb" alt="Current logo"
         <% if site.logo.attached? %>src="<%= url_for(site.logo) %>"<% else %>hidden<% end %>>
    <div class="designer__logo-actions">
      <label class="button">
        Upload logo image
        <input type="file" class="designer__file" accept="<%= Site::LOGO_CONTENT_TYPES.join(",") %>"
               data-designer-target="logoInput" data-action="designer#uploadLogo">
      </label>
      <button type="button" class="button button--ghost" data-designer-target="logoRemove"
              data-action="designer#removeLogo" <%= "hidden" unless site.logo.attached? %>>Remove</button>
      <span class="designer__hint u-text-muted">&hellip;or drag an image here</span>
    </div>
  </div>
  <label class="designer__check" data-designer-target="logoTitleWrap" <%= "hidden" unless site.logo.attached? %>
         title="Unchecked, the site title appears beside the logo instead">
    <input type="checkbox" checked data-designer-target="logoTitleAsAlt" data-action="designer#logoTitleEdited">
    <span>Site title as alt only</span>
  </label>
  <p class="designer__hint u-text-muted">JPG, PNG, AVIF, WebP, or SVG up to <%= Site::LOGO_MAX_SIZE / 1.megabyte %> MB. Saves to the account right away (same logo as System settings).</p>
</section>
