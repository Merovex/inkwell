<% content_for :title, "Site designer — Inkwell" %>

<%# The full-screen editor (layout: book_designer): top bar, canvas showing a
    real Hugo build, and a rail organized as a root menu of summary rows with
    sub-panes (no routing — panes are shown/hidden by the designer
    controller, teardown-style). Axis grouping comes from the theme
    manifest's per-axis `section`; rows for parts the theme can't customize
    yet render as disabled placeholders, so the full menu shape is always on
    screen. The working design lives in localStorage until Save exists
    (docs/site-designer.md §2.2). %>
<%
  hero_axes = @theme.axes.select { |axis| axis["section"] == "hero" }
  style_axes = @theme.axes.select { |axis| axis["section"] == "styles" }
  # mode lives INSIDE the palette pane (section "palette"), not as its own row
  mode_axis = @theme.axes.find { |axis| axis["key"] == "mode" }
  page_sections = @theme.axes.reject { |axis| axis["section"].in?(%w[hero styles palette]) }
    .group_by { |axis| axis["section"] }
%>
<div class="designer"
     data-controller="designer"
     data-designer-build-url-value="<%= admin_designer_preview_path %>"
     data-designer-frame-url-value="<%= admin_designer_preview_file_path(path: nil) %>/"
     data-designer-storage-key-value="inkwell:design:<%= Current.account.slug %>"
     data-designer-defaults-value="<%= @theme.defaults.to_json %>"
     data-designer-version-url-value="<%= admin_designer_preview_version_path %>"
     data-designer-logo-url-value="<%= admin_designer_logo_path %>"
     data-designer-colors-url-value="<%= asset_path("tailwind_colors.json") %>"
     data-designer-watch-value="<%= Rails.env.development? ? 1500 : 0 %>">

  <header class="designer__topbar">
    <div class="designer__topbar-side">
      <%= link_to admin_root_path, class: "button button--ghost" do %>&larr; Admin<% end %>
      <h1 class="designer__title">Site designer</h1>
    </div>
    <div class="designer__topbar-side">
      <p class="designer__status" data-designer-target="status" aria-live="polite">Loading preview&hellip;</p>
      <button type="button" class="button" data-action="designer#reset">Discard changes</button>
      <button type="button" class="button button--primary" disabled
              title="Coming soon — for now the design stays in this browser only">Save</button>
    </div>
  </header>

  <div class="designer__body">
    <section class="designer__canvas" aria-label="Site preview">
      <div class="designer__canvas-bar">
        <p class="designer__scale-note u-text-muted" data-designer-target="scaleNote">Preview shown at 70%.</p>
        <div class="button-group" role="group" aria-label="Preview width">
          <button type="button" class="button-group__btn designer__viewport is-active" data-action="designer#viewport"
                  data-designer-width-param="desktop" aria-pressed="true">Desktop</button>
          <button type="button" class="button-group__btn designer__viewport" data-action="designer#viewport"
                  data-designer-width-param="mobile" aria-pressed="false">Mobile</button>
        </div>
      </div>
      <div class="designer__stage" data-designer-target="stage" data-viewport="desktop">
        <div class="designer__scaler">
          <iframe class="designer__frame" data-designer-target="frame" title="Site preview" src="about:blank"></iframe>
        </div>
      </div>
    </section>

    <aside class="designer__rail" aria-label="Design options">
      <%# --- root menu --- %>
      <div class="designer__pane" data-designer-target="pane" data-pane="root">
        <h2 class="designer__rail-title">Edit website</h2>

        <section class="designer__group" aria-label="Hero">
          <h3 class="designer__group-title">Hero</h3>
          <div class="designer__featured">
            <div class="designer__featured-thumb" aria-hidden="true"></div>
            <p class="designer__featured-name"><span data-summary-for="hero">&hellip;</span></p>
            <button type="button" class="button button--primary" data-action="designer#showPane"
                    data-designer-pane-param="hero">Customize hero</button>
          </div>
        </section>

        <section class="designer__group" aria-label="Site styles">
          <h3 class="designer__group-title">Site styles</h3>
          <button type="button" class="designer__row" data-action="designer#showPane" data-designer-pane-param="preset">
            <span class="designer__row-label">Preset</span>
            <span class="designer__row-value" data-designer-target="preset">&hellip;</span>
          </button>
          <% style_axes.each do |axis| %>
            <% if axis["control"] == "slider" %>
              <%# Slider axes have no visual chip — a plain summary row. %>
              <button type="button" class="designer__row" data-action="designer#showPane" data-designer-pane-param="<%= axis["key"] %>">
                <span class="designer__row-label"><%= axis["noun"] %></span>
                <span class="designer__row-value"><span data-summary-for="<%= axis["key"] %>">&hellip;</span></span>
              </button>
              <% next %>
            <% end %>
            <button type="button" class="designer__row designer__row--card" data-action="designer#showPane" data-designer-pane-param="<%= axis["key"] %>">
              <span class="designer__row-chip" data-chip-for="<%= axis["key"] %>" aria-hidden="true">
                <% if axis["key"] == "font" %>
                  <span class="designer__chip-abc">ABC</span>
                <% else %>
                  <%# One chip per option (wireframe or swatches); the controller
                      reveals the one matching the working design. %>
                  <% axis["options"].each do |option| %>
                    <% if option["wireframe"] %>
                      <span class="designer__chip-option" data-option="<%= option["id"] %>" hidden><%= @theme.wireframe(option["wireframe"]) %></span>
                    <% elsif option["swatches"] %>
                      <span class="designer__chip-option designer__chip-swatches" data-option="<%= option["id"] %>" hidden>
                        <% option["swatches"].each do |color| %><span class="designer__swatch" style="background: <%= color %>"></span><% end %>
                      </span>
                    <% end %>
                  <% end %>
                <% end %>
              </span>
              <span class="designer__row-text">
                <span class="designer__row-label"><%= axis["noun"] %></span>
                <span class="designer__row-value">
                  <span data-summary-for="<%= axis["key"] %>">&hellip;</span><% if axis["key"] == "palette" %> &middot; <span data-summary-for="mode">&hellip;</span><% end %>
                </span>
              </span>
              <%= inline_svg_tag "lucide/pencil.svg", class: "lucide designer__row-icon", size: "16px" %>
            </button>
          <% end %>
        </section>

        <section class="designer__group" aria-label="Page sections">
          <h3 class="designer__group-title">Page sections</h3>
          <% page_sections.each do |section, axes| %>
            <button type="button" class="designer__row" data-action="designer#showPane" data-designer-pane-param="<%= section %>">
              <span class="designer__row-label"><%= section.humanize %></span>
              <span class="designer__row-value">
                <% axes.each_with_index do |axis, i| %><%= " · " if i.positive? %><span data-summary-for="<%= axis["key"] %>">&hellip;</span><% end %>
              </span>
            </button>
          <% end %>
          <button type="button" class="designer__row" disabled title="Blog list/grid layouts arrive with the posts presentation">
            <span class="designer__row-label">Blog</span>
            <span class="designer__row-value">Coming</span>
          </button>
          <button type="button" class="designer__row" disabled title="Arrives when home.sections becomes editable">
            <span class="designer__row-label">&#8645; Change section order</span>
          </button>
        </section>

        <p class="designer__hint u-text-muted">Choices are kept in this browser only while the design schema is being worked out. Saving to the account comes later.</p>
      </div>

      <%# --- sub-panes: hero, preset, one per style axis, one per page section --- %>
      <div class="designer__pane" data-designer-target="pane" data-pane="hero" hidden>
        <button type="button" class="designer__pane-back" data-action="designer#back">&larr; Edit website</button>
        <% hero_axes.each do |axis| %>
          <%= render "axis", axis: axis %>
        <% end %>
      </div>

      <div class="designer__pane" data-designer-target="pane" data-pane="preset" hidden>
        <button type="button" class="designer__pane-back" data-action="designer#back">&larr; Edit website</button>
        <section class="designer__block" aria-label="Presets">
          <h3 class="designer__block-title">Presets</h3>
          <div class="designer__options">
            <% @theme.presets.each do |preset| %>
              <button type="button" class="button button--small designer__preset" data-action="designer#applyPreset"
                      data-designer-axes-param="<%= preset["axes"].to_json %>">
                <%= preset["label"] %>
              </button>
            <% end %>
          </div>
          <p class="designer__hint u-text-muted">A preset sets every axis at once; the label is derived from the current combination.</p>
        </section>
      </div>

      <% style_axes.each do |axis| %>
        <div class="designer__pane" data-designer-target="pane" data-pane="<%= axis["key"] %>" hidden>
          <button type="button" class="designer__pane-back" data-action="designer#back">&larr; Edit website</button>
          <% if axis["key"] == "palette" %>
            <%# Mode belongs to the palette: it leads the pane. %>
            <%= render "axis", axis: mode_axis %>
            <p class="designer__hint u-text-muted">Auto follows each reader's own system preference; every palette carries a designed light and dark rendition.</p>
          <% end %>
          <% if axis["control"] == "slider" %>
            <%= render "slider", axis: axis %>
          <% else %>
            <%= render "axis", axis: axis %>
          <% end %>
          <% if axis["key"] == "nav" %>
            <%= render "logo" %>
            <%= render "header_links" %>
          <% end %>
          <%= render "custom_fonts" if axis["key"] == "font" %>
          <%= render "custom_colors" if axis["key"] == "palette" %>
        </div>
      <% end %>

      <% page_sections.each do |section, axes| %>
        <div class="designer__pane" data-designer-target="pane" data-pane="<%= section %>" hidden>
          <button type="button" class="designer__pane-back" data-action="designer#back">&larr; Edit website</button>
          <%# Boolean-ish axes read better as switches than chips, and they
              lead the pane. Checked = the axis's first option (its default);
              option labels feed the row summary. %>
          <% toggle_labels = {
            "books" => "Show on home page",
            "catalog" => "Show only the first book of each series",
            "alternate" => "Alternate sides row by row"
          } %>
          <% toggle_axes, rest = axes.partition { |axis| toggle_labels.key?(axis["key"]) } %>
          <% slider_axes, chip_axes = rest.partition { |axis| axis["control"] == "slider" } %>
          <% toggle_axes.each do |axis| %>
            <% on_option, off_option = axis["options"] %>
            <label class="switch">
              <input class="switch__input" type="checkbox" checked
                     data-designer-target="axisToggle" data-axis="<%= axis["key"] %>"
                     data-on="<%= on_option["id"] %>" data-off="<%= off_option["id"] %>"
                     data-on-label="<%= on_option["label"] %>" data-off-label="<%= off_option["label"] %>"
                     data-action="designer#axisToggled">
              <%= toggle_labels[axis["key"]] %>
            </label>
          <% end %>
          <% slider_axes.each do |axis| %>
            <%= render "slider", axis: axis %>
          <% end %>
          <% chip_axes.each do |axis| %>
            <%= render "axis", axis: axis %>
          <% end %>
        </div>
      <% end %>
    </aside>
  </div>
</div>
