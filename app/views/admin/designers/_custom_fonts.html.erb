<%# The escape valve past the pairings: pick any Google Fonts heading/body.
    Standard modal; each field is a font-picker typeahead over the vendored
    list, and picks land in the working design's fonts block. %>
<%# The remembered custom pairing (localStorage only, like the rest of the
    working state): once the author has picked custom fonts it renders as a
    card that survives switching to a pairing — click to reactivate. It
    joins the font radio group for free mutual exclusion, but read() skips
    it (data-custom-font): its value is never a design axis value. %>
<div class="designer__options" data-designer-target="customFontCard" hidden>
  <label class="design-option design-option--card design-option--font">
    <input type="radio" class="design-option__input" name="design[font]" value=""
           data-custom-font data-label="Custom" data-action="designer#customFontCardPicked">
    <span class="design-option__label">
      <span class="design-option__font-name" data-designer-target="customFontName">Custom</span>
      <span class="design-option__font-families" data-designer-target="customFontFamilies"></span>
      <span class="design-option__font-tagline">Your own heading &amp; body picks</span>
    </span>
  </label>
</div>
<section class="designer__block" aria-label="Custom fonts">
  <h3 class="designer__block-title">Custom fonts</h3>
  <span data-controller="dialog">
    <button type="button" class="button" data-action="dialog#open">Pick your own fonts</button>
    <dialog class="modal" data-dialog-target="modal" data-action="click->dialog#backdrop"
            aria-labelledby="designer-fonts-title">
      <div class="modal__header">
        <span class="modal__title" id="designer-fonts-title">Custom fonts</span>
        <button type="button" class="button button--icon button--ghost" data-action="dialog#close" aria-label="Close">
          <%= inline_svg_tag "lucide/x.svg", class: "lucide", size: "20px" %>
        </button>
      </div>
      <div class="modal__body u-flow">
        <p class="u-text-muted">Any Google Font, for the heading or the body or both — whatever you leave blank keeps the pairing's face. Type a few letters to search.</p>
        <% { display: "Heading font", body: "Body font" }.each do |slot, label| %>
          <div class="field font-picker" data-controller="font-picker"
               data-font-picker-url-value="<%= asset_path("google_fonts.json") %>"
               data-font-picker-slot-value="<%= slot %>"
               data-action="font-picker:change->designer#customFontPicked">
            <label class="field__label" for="designer-font-<%= slot %>"><%= label %></label>
            <input type="text" id="designer-font-<%= slot %>" class="field__control" autocomplete="off"
                   role="combobox" aria-expanded="false" aria-autocomplete="list" placeholder="Search Google Fonts&hellip;"
                   data-font-picker-target="input"
                   data-action="input->font-picker#search focus->font-picker#search blur->font-picker#close keydown->font-picker#navigate">
            <ul class="font-picker__list u-unlist" role="listbox" data-font-picker-target="list" hidden></ul>
          </div>
        <% end %>
      </div>
      <div class="modal__footer">
        <button type="button" class="button button--ghost" data-action="designer#clearCustomFonts">Back to the pairing</button>
        <button type="button" class="button button--primary" data-action="dialog#close">Done</button>
      </div>
    </dialog>
  </span>
  <p class="designer__hint u-text-muted">Custom picks load at regular weight; bold and italics are synthesized by the browser.</p>
</section>
