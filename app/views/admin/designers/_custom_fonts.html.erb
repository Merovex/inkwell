<%# The escape valve past the pairings, inline: any Google Font for the
    headings and the body, each picker with a live preview line set in the
    pick (the font-picker loads the face's stylesheet on selection). Picks
    apply as they land — the whole designer is live — and the pairing is
    remembered as the "Custom" card. %>
<%# The remembered custom pairing (localStorage only, like the rest of the
    working state): once the author has picked custom fonts it renders as a
    card that survives switching to a pairing — click to reactivate. It
    joins the font radio group for free mutual exclusion, but read() skips
    it (data-custom-font): its value is never a design axis value. %>
<div class="designer__options" data-designer-target="customFontCard" hidden>
  <label class="design-option design-option--card design-option--font">
    <input type="radio" class="design-option__input" name="design[font]" value=""
           data-custom-font data-label="Custom" data-action="designer#customFontCardPicked">
    <span class="design-option__label">
      <span class="design-option__font-name" data-designer-target="customFontName">Custom</span>
      <span class="design-option__font-specimen">Your own heading &amp; body picks</span>
      <span class="design-option__font-families u-text-muted" data-designer-target="customFontFamilies"></span>
    </span>
  </label>
</div>
<section class="designer__block u-flow" aria-label="Your own pairing">
  <div class="u-cluster u-cluster-between">
    <h3 class="designer__group-title u-microcaps u-text-muted u-margin-0">Your own pairing</h3>
    <p class="u-margin-0 u-text-small u-text-muted">Any Google font</p>
  </div>
  <% { display: { label: "Headings", preview: "A House Without Doors" },
       body: { label: "Body", preview: "She had counted on one tide and the sea gave her two, which is more or less how the year went." } }.each do |slot, slot_info| %>
    <div class="designer__font-slot">
      <div class="field font-picker u-pad-half" data-controller="font-picker"
           data-font-picker-url-value="<%= asset_path("google_fonts.json") %>"
           data-font-picker-slot-value="<%= slot %>"
           data-action="font-picker:change->designer#customFontPicked">
        <label class="field__label u-microcaps u-text-muted" for="designer-font-<%= slot %>"><%= slot_info[:label] %></label>
        <input type="text" id="designer-font-<%= slot %>" class="field__control" autocomplete="off"
               role="combobox" aria-expanded="false" aria-autocomplete="list" placeholder="Search Google Fonts&hellip;"
               data-font-picker-target="input"
               data-action="input->font-picker#search focus->font-picker#search blur->font-picker#close keydown->font-picker#navigate">
        <ul class="font-picker__list u-unlist" role="listbox" data-font-picker-target="list" hidden></ul>
      </div>
      <p class="designer__font-preview" data-designer-target="custom<%= slot.to_s.classify %>Preview"><%= slot_info[:preview] %></p>
    </div>
  <% end %>
  <div class="u-cluster">
    <button type="button" class="button button--ghost" data-action="designer#clearCustomFonts">Back to the pairing</button>
    <p class="designer__hint u-text-muted">Saved as &ldquo;Custom&rdquo; &mdash; applies as you pick.</p>
  </div>
  <p class="designer__hint u-text-muted">Two families keep the site fast. Picks load at regular weight; bold and italics are synthesized by the browser.</p>
</section>
