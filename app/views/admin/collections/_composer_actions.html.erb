<%# locals: (collection:) %>
<% if collection.persisted? && collection.published? %>
  <%= link_to "Never mind", admin_collection_path(collection.record), class: "button" %>
  <%= button_tag "Update", form: "composer", class: "button button--primary" %>
<% elsif collection.persisted? && collection.scheduled? %>
  <%= render "admin/shared/scheduler", form: "composer", schedulable: collection,
        noun: "collection", drafts_href: admin_collections_path, drafts_label: "Collections" %>
  <%= link_to "Never mind", admin_collection_path(collection.record), class: "button" %>
  <%= button_tag "Save", form: "composer", class: "button button--primary" %>
<% else %>
  <%= render "admin/shared/scheduler", form: "composer",
        noun: "collection", drafts_href: admin_collections_path, drafts_label: "Collections" %>
  <%= button_tag "Save draft", form: "composer", class: "button" %>
  <%= button_tag "Publish", form: "composer", name: "publish", value: "1", class: "button button--primary" %>
<% end %>
