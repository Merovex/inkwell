<%# One subscriber, opened into the roster's "modal" turbo frame (the row links
    here with data-turbo-frame="modal"). Lifecycle dates + what they've received
    and opened, then the recent sends. %>
<% content_for :title, @subscriber.email_address %>
<% variant = { "confirmed" => "success", "pending" => "warning", "bounced" => "danger", "complained" => "danger" }[@subscriber.status] %>

<%= turbo_frame_tag "modal" do %>
  <div data-controller="dialog" data-dialog-open-value="true">
    <dialog class="modal" data-dialog-target="modal" data-action="click->dialog#backdrop"
            aria-labelledby="subscriber-title">
      <div class="modal__header">
        <span class="modal__title" id="subscriber-title"><%= @subscriber.email_address %></span>
        <button type="button" class="button button--icon button--ghost" data-action="dialog#close" aria-label="Close">
          <%= inline_svg_tag "lucide/x.svg", class: "lucide", size: "20px" %>
        </button>
      </div>

      <div class="modal__body u-stack">
        <dl class="facts">
          <div class="facts__row">
            <dt>Status</dt>
            <dd><span class="badge<%= " badge--#{variant}" if variant %>"><%= @subscriber.status.capitalize %></span></dd>
          </div>
          <div class="facts__row">
            <dt>Signed up</dt>
            <dd><%= l @subscriber.created_at.to_date, format: :long %><% if @subscriber.source_description %> · <%= @subscriber.source_description %><% end %></dd>
          </div>
          <% if @subscriber.confirmed_at %>
            <div class="facts__row">
              <dt>Confirmed</dt>
              <dd><%= l @subscriber.confirmed_at.to_date, format: :long %></dd>
            </div>
          <% end %>
          <%# Consent evidence a partner sent with the opt-in (Subscriber.
              opt_in_confirmed) — the answer to "on what basis is this address
              on the list?", where anyone answering a reader would look. %>
          <% if @subscriber.country_code.present? %>
            <div class="facts__row">
              <dt>Signed up from</dt>
              <dd>
                <%= @subscriber.country_code %>
                <% if @subscriber.gdpr_country %><span class="badge badge--accent">GDPR</span><% end %>
              </dd>
            </div>
          <% end %>
          <div class="facts__row">
            <dt>Received</dt>
            <dd><%= pluralize(@received, "post") %></dd>
          </div>
          <% if @received.positive? %>
            <div class="facts__row">
              <dt>Opened</dt>
              <dd><%= @opened %> of <%= @received %><% if @last_opened_at %> · last <%= l @last_opened_at.to_date, format: :long %><% end %></dd>
            </div>
          <% end %>
        </dl>

        <% if @magnets.any? %>
          <section class="u-stack-half" aria-labelledby="downloads">
            <h3 class="u-microcaps u-text-muted" id="downloads">Downloads</h3>
            <div class="list">
              <% @magnets.each do |magnet| %>
                <% grant = @grants_by_magnet[magnet.id] %>
                <%= render "shared/list_item",
                      avatar: false,
                      title_tag: "span",
                      title: magnet.title,
                      date: (l(grant.created_at.to_date, format: :short) if grant),
                      actions: (capture do
                        if @subscriber.confirmed?
                          button_to (grant ? "Re-send link" : "Send link"),
                            admin_subscriber_magnet_claim_renewal_path(@subscriber, magnet),
                            class: "button button--small",
                            form: { data: { turbo_frame: "_top",
                              turbo_confirm: "Email a fresh #{magnet.title} download link to #{@subscriber.email_address}?" } }
                        end
                      end) %>
              <% end %>
            </div>
          </section>
        <% end %>

        <% if @deliveries.any? %>
          <section class="u-stack-half" aria-labelledby="recent-sends">
            <h3 class="u-microcaps u-text-muted" id="recent-sends">Recent sends</h3>
            <div class="list">
              <% @deliveries.first(5).each do |delivery| %>
                <% post = delivery.broadcast.record.recordable %>
                <% sent_on = delivery.sent_at || delivery.created_at %>
                <%= render "shared/list_item",
                      avatar: false,
                      title_tag: "span",
                      title: (post&.title || "(removed post)"),
                      date: l(sent_on.to_date, format: :short),
                      trailing_chips: (delivery.opened_at ? [ [ "Opened", "success" ] ] : [ [ "Not opened", nil ] ]) %>
              <% end %>
            </div>
          </section>
        <% end %>
      </div>

      <div class="modal__footer modal__footer--split">
        <% unless @subscriber.unsubscribed? %>
          <%= button_to "Unsubscribe", unsubscribe_admin_subscriber_path(@subscriber), method: :patch,
                class: "button button--danger", form: { data: { turbo_frame: "_top" } },
                data: { turbo_confirm: "Unsubscribe #{@subscriber.email_address}?" } %>
        <% else %>
          <span></span>
        <% end %>
        <button type="button" class="button button--primary" data-action="dialog#close">Done</button>
      </div>
    </dialog>
  </div>
<% end %>
