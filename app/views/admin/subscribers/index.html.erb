<% content_for :title, "Subscribers" %>

<%= render "admin/shared/canvas_head", crumbs: [["Subscribers", nil]] %>

<div class="subscribers" data-controller="filter" data-filter-unit-value="subscriber">
<header class="perma-header">
  <h1 class="perma-header__title">Subscribers</h1>
  <div class="perma-header__content">
    <%# One state at a time; each tab links to that state's view. %>
    <nav class="perma-header__toolbar" aria-label="Subscriber states">
      <% Admin::SubscribersController::STATES.each do |state| %>
        <%# Deliverability problems call themselves out while they have anyone %>
        <%# in them: bounced is amber, complained (spam) is red. %>
        <% attention = @counts[state].to_i.positive? && { "bounced" => "warning", "complained" => "danger" }[state] %>
        <%= link_to admin_subscribers_path(state: state),
              class: "button button--small#{' button--primary' if state == @state}#{" button--#{attention}" if attention && state != @state}",
              aria: { current: ("page" if state == @state) } do %>
          <%= state.capitalize %> <span class="button__count">(<%= @counts[state].to_i %>)</span><% if attention %> · needs attention<% end %>
        <% end %>
      <% end %>
      <%= link_to admin_subscribers_path(state: @state, format: :csv), class: "button button--small" do %>
        <%= inline_svg_tag "lucide/file-text.svg", class: "lucide", size: "16px" %> Export
      <% end %>
      <%# The platform's cross-site suppression list as it bears on this roster. %>
      <%= link_to "Suppressed", admin_suppressions_path, class: "button button--small" %>
      <%# Screenshot safety: masks every address to cat•••@… so the list can be %>
      <%# shared without leaking who's on it. On by default; pure CSS. %>
      <label class="switch mask-toggle">
        <input class="switch__input" type="checkbox" id="mask-addresses" checked>
        Mask addresses
      </label>
    </nav>
  </div>
  <div class="perma-header__content">
    <div class="filter-by-text filter-by-text--wide">
      <input class="filter-by-text__input" type="search" placeholder=" " autocomplete="off"
             aria-label="Search subscribers by address"
             data-filter-target="input"
             data-action="input->filter#apply keydown.esc->filter#clear">
      <label class="filter-by-text__hotkey">Search by address…</label>
    </div>
  </div>
</header>

<%# The headline: how big the list is, how it moved this month and from where,
    and how many chose to go this quarter. Departures are a count, not a rate —
    one leaver out of a dozen readers is 8%, which alarms without informing. %>
<dl class="stats">
  <div class="stat">
    <dt class="stat__label">readers</dt>
    <dd class="stat__value"><%= @movement.sendable %></dd>
  </div>
  <div class="stat">
    <dt class="stat__label">net, last 30 days</dt>
    <dd class="stat__value"><%= signed_count(@movement.net) %></dd>
  </div>
  <% if @movement.departures.positive? %>
    <div class="stat stat--trouble">
      <dt class="stat__label">left, last 90 days</dt>
      <dd class="stat__value"><%= @movement.departures %></dd>
    </div>
  <% end %>
</dl>

<% if @movement.joined_by_source.any? %>
  <p class="u-text-muted u-margin-block-end">
    This month's arrivals:
    <%= @movement.joined_by_source.map { |source, count| "#{count} from #{source}" }.to_sentence %>.
  </p>
<% end %>

<% if @subscribers.any? %>
  <div class="table-scroll" data-filter-target="section">
    <table class="table">
      <thead>
        <tr>
          <th scope="col">Address</th>
          <th scope="col">Source</th>
          <th scope="col">Joined</th>
          <th scope="col">Last opened</th>
          <th scope="col"><span class="u-visually-hidden">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        <% @subscribers.each do |subscriber| %>
          <%= render "admin/subscribers/subscriber", subscriber: subscriber,
                actions: render("admin/subscribers/actions_menu", subscriber: subscriber, magnets: @magnets) %>
        <% end %>
      </tbody>
    </table>
  </div>
  <p class="u-text-muted u-margin-block-end" data-filter-target="blank" hidden>No subscribers match.</p>
<% else %>
  <div class="empty">
    <span class="empty__icon"><%= inline_svg_tag "lucide/inbox.svg", class: "lucide", size: "40px" %></span>
    <p class="empty__title">No <%= @state %> subscribers</p>
    <p class="empty__text">
      <% if @state == "confirmed" %>
        Confirmed subscribers — those who completed double opt-in — appear here.
      <% elsif @state == "pending" %>
        People who signed up but haven't confirmed their email yet appear here.
      <% elsif @state == "bounced" %>
        Addresses that hard-bounced — permanently undeliverable — appear here and won't be emailed again.
      <% elsif @state == "complained" %>
        People who marked an issue as spam appear here and won't be emailed again.
      <% else %>
        People who've unsubscribed (or were sunset for inactivity) appear here.
      <% end %>
    </p>
  </div>
<% end %>
</div>

<%# Row click opens the subscriber detail here. %>
<%= turbo_frame_tag "modal" %>
