<% content_for :title, "Subscribers — Inkwell" %>

<%= render "admin/shared/canvas_head", crumbs: [["Subscribers", nil]] %>

<header class="perma-header">
  <h1 class="perma-header__title">Subscribers</h1>
  <div class="perma-header__content">
    <%# One state at a time; each tab links to that state's view. %>
    <nav class="perma-header__toolbar" aria-label="Subscriber states">
      <% Admin::SubscribersController::STATES.each do |state| %>
        <%= link_to admin_subscribers_path(state: state),
              class: "button button--small#{' button--primary' if state == @state}",
              aria: { current: ("page" if state == @state) } do %>
          <%= state.capitalize %> <span class="u-text-muted">(<%= @counts[state].to_i %>)</span>
        <% end %>
      <% end %>
      <%= link_to admin_subscribers_path(state: @state, format: :csv), class: "button button--small" do %>
        <%= inline_svg_tag "lucide/file-text.svg", class: "lucide", size: "16px" %> Export
      <% end %>
    </nav>
  </div>
</header>

<% if @subscribers.any? %>
  <div class="list">
    <% @subscribers.each do |subscriber| %>
      <% actions = capture do %>
        <% if subscriber.seed? %>
          <%= button_to admin_subscriber_seed_path(subscriber), method: :delete,
                class: "button button--icon button--ghost", title: "Unmark seed",
                "aria-label": "Unmark #{redacted_email(subscriber.email_address)} as a deliverability seed",
                form: { data: { turbo_confirm: "Treat #{redacted_email(subscriber.email_address)} as a real subscriber again?" } } do %>
            <%= inline_svg_tag "lucide/flask-conical.svg", class: "lucide", size: "16px" %>
          <% end %>
        <% else %>
          <%= button_to admin_subscriber_seed_path(subscriber), method: :post,
                class: "button button--icon button--ghost", title: "Mark as seed",
                "aria-label": "Mark #{redacted_email(subscriber.email_address)} as a deliverability seed",
                form: { data: { turbo_confirm: "Mark #{redacted_email(subscriber.email_address)} as a deliverability seed? Seeds get no broadcasts or drips and don't count in the roster." } } do %>
            <%= inline_svg_tag "lucide/flask-conical.svg", class: "lucide", size: "16px" %>
          <% end %>
        <% end %>
        <% if subscriber.pending? %>
          <%= button_to resend_admin_subscriber_path(subscriber), method: :post,
                class: "button button--icon button--ghost", title: "Resend confirmation",
                "aria-label": "Resend confirmation to #{redacted_email(subscriber.email_address)}",
                form: { data: { turbo_confirm: "Resend the confirmation email to #{redacted_email(subscriber.email_address)}?" } } do %>
            <%= inline_svg_tag "lucide/send.svg", class: "lucide", size: "16px" %>
          <% end %>
        <% end %>
        <% unless subscriber.unsubscribed? || subscriber.bounced? || subscriber.complained? %>
          <%= button_to unsubscribe_admin_subscriber_path(subscriber), method: :patch,
                class: "button button--icon button--ghost", title: "Unsubscribe",
                "aria-label": "Unsubscribe #{redacted_email(subscriber.email_address)}",
                form: { data: { turbo_confirm: "Unsubscribe #{redacted_email(subscriber.email_address)}?" } } do %>
            <%= inline_svg_tag "lucide/circle-x.svg", class: "lucide", size: "16px" %>
          <% end %>
        <% end %>
      <% end %>
      <%= render "shared/list_item",
            title: redacted_email(subscriber.email_address),
            avatar: false,
            badge: (subscriber.seed? ? "Seed" : ("Nudged" if subscriber.confirmed? && subscriber.re_engagement_sent_at)),
            badge_variant: (subscriber.seed? ? "accent" : "warning"),
            author: "#{"via #{subscriber.source} · " if subscriber.source.present?}joined #{subscriber.created_at.strftime("%b %-d, %Y")}#{" · updated #{subscriber.updated_at.strftime('%b %-d, %Y')}" if subscriber.updated_at.to_date != subscriber.created_at.to_date}#{" · last opened #{subscriber.last_engaged_at.strftime('%b %-d, %Y')}" if subscriber.last_engaged_at}",
            actions: actions %>
    <% end %>
  </div>
<% else %>
  <div class="empty">
    <span class="empty__icon"><%= inline_svg_tag "lucide/inbox.svg", class: "lucide", size: "40px" %></span>
    <p class="empty__title">No <%= @state %> subscribers</p>
    <p class="empty__text">
      <% if @state == "confirmed" %>
        Confirmed subscribers — those who completed double opt-in — appear here.
      <% elsif @state == "pending" %>
        People who signed up but haven't confirmed their email yet appear here.
      <% elsif @state == "bounced" %>
        Addresses that hard-bounced — permanently undeliverable — appear here and won't be emailed again.
      <% elsif @state == "complained" %>
        People who marked an issue as spam appear here and won't be emailed again.
      <% else %>
        People who've unsubscribed (or were sunset for inactivity) appear here.
      <% end %>
    </p>
  </div>
<% end %>
