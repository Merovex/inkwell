<%# locals: (record:, book:, heading: true) %>
<%# A book's collections as cards, with a typeahead below to add more. %>
<section class="book-collections u-flow">
  <% if heading %><h2 class="subhead">Collections</h2><% end %>
  <ul class="collection-cards u-unlist" id="book_collections">
    <% book.installments.each do |installment| %>
      <% collection = Current.account.collections.find_by(record_id: installment.container_record_id) %>
      <% next unless collection %>
      <%= render "admin/books/collection_row", installment: installment, collection: collection, book: book %>
    <% end %>
  </ul>
  <%= render "admin/installments/combobox",
        context: "book_collection", url: search_admin_collections_path,
        anchor_param: "book_record_id", selected_param: "container_record_id",
        anchor_id: record.id, placeholder: "Add to a collection…" %>
</section>
