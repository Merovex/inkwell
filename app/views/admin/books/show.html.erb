<% content_for :title, @book.title %>
<% can_manage = allowed_to?(:manage, @record) %>
<% primary = @book.series.first %>
<% series_books = primary ? primary.books.to_a : [] %>
<% position = series_books.index { |b| b.record_id == @book.record_id }&.+(1) %>

<div data-controller="editable">
  <%= render "admin/shared/canvas_head", crumbs: [["Books", admin_books_path], [@book.title, nil]],
        edit_href: (edit_admin_book_path(@record) if can_manage) do %>
    <% if can_manage %>
      <% if @book.published? %>
        <%= button_to "Revert to draft", admin_book_publish_path(@record), method: :delete, class: "menu__item" %>
      <% else %>
        <%= button_to "Publish", admin_book_publish_path(@record), class: "menu__item" %>
      <% end %>
      <hr class="menu__separator">
    <% end %>
    <%= link_to "Change log", admin_book_events_path(@record), class: "menu__item" %>
    <% if can_manage %>
      <hr class="menu__separator">
      <%= render "admin/shared/archive_menu_item", record: @record %>
      <%= button_to "Move to trash", admin_book_path(@record), method: :delete, class: "menu__item" %>
    <% end %>
  <% end %>

  <div class="book-detail">
    <%# ── Left rail: cover + stats ── %>
    <aside class="book-detail__left u-flow" aria-label="Cover and details">
      <%= turbo_frame_tag "book_cover" do %>
        <% if can_manage %>
          <%= render "cover", book: @book, record: @record %>
        <% elsif @book.cover? %>
          <%= image_tag @book.cover, class: "cover book-detail__cover", alt: "#{@book.title} cover" %>
        <% else %>
          <span class="cover book-detail__cover cover--blank u-center-content" aria-hidden="true">No cover</span>
        <% end %>
      <% end %>

      <dl class="facts">
        <% if @book.word_count %>
          <div class="facts__row"><dt>Length</dt><dd><%= number_with_delimiter(@book.word_count) %> words</dd></div>
        <% end %>
        <% if @book.isbn.present? %>
          <div class="facts__row"><dt>ISBN</dt><dd><%= @book.isbn %></dd></div>
        <% end %>
      </dl>
    </aside>

    <%# ── Middle: header, tagline, description, series position ── %>
    <div class="book-detail__main u-flow">
      <header class="u-flow">
        <p class="book-detail__status u-text-muted">
          <% if @book.published? %>
            <span class="badge badge--accent">Published</span>
          <% elsif @book.scheduled? %>
            <span class="badge badge--accent">Scheduled · <%= @book.published_at.strftime("%b %-d") %></span>
          <% else %>
            <span class="badge">Draft</span>
          <% end %>
          <% if @book.publication_date %> · Released <%= @book.publication_date.strftime("%B %Y") %><% end %>
        </p>

        <% if can_manage %>
          <h1 class="perma-header__title" data-editable-target="display"><button type="button"
              class="u-unbutton editable__display"
              data-action="dblclick->editable#edit keydown.enter->editable#edit"
              title="Double-click to rename"><%= @book.title %></button></h1>
          <%= form_with model: @book, url: admin_book_path(@record) do |f| %>
            <%= f.text_field :title, hidden: true, class: "perma-header__title editable__input",
                  aria: { label: "Title" },
                  data: { editable_target: "input",
                          action: "blur->editable#save keydown.enter->editable#save keydown.esc->editable#cancel" } %>
          <% end %>
        <% else %>
          <h1 class="perma-header__title"><%= @book.title %></h1>
        <% end %>

        <% if primary %>
          <p class="book-detail__kicker">
            <%= link_to primary.title, admin_series_path(primary.record) %><% if position %> · Book <%= position %> of <%= series_books.size %><% end %>
          </p>
        <% end %>
      </header>

      <% if @book.tagline.present? %>
        <p class="book-detail__tagline"><%= @book.tagline %></p>
      <% end %>

      <% if @book.content.blank? %>
        <p class="prose u-text-muted"><%= can_manage ? "No description yet — add one from Edit." : "No description yet." %></p>
      <% else %>
        <article class="prose"><%= @book.content %></article>
      <% end %>

      <% if primary %>
        <section class="u-flow" aria-labelledby="series-order-heading">
          <h2 id="series-order-heading" class="subhead">Where it sits in the series</h2>
          <ol class="series-order u-unlist u-surface u-divided">
            <% series_books.each_with_index do |book, i| %>
              <% current = book.record_id == @book.record_id %>
              <li class="series-order__row<%= " series-order__row--current" if current %>">
                <span class="series-order__num"><%= i + 1 %></span>
                <span class="cover cover--blank series-order__cover" aria-hidden="true"></span>
                <span class="series-order__title">
                  <% if current %><span class="u-text-strong"><%= book.title %></span>
                  <% else %><%= link_to book.title, admin_book_path(book.record) %><% end %>
                </span>
                <span class="series-order__status">
                  <% if current %>
                    <span class="badge badge--accent">This book</span>
                  <% elsif book.published? %>
                    <span class="u-text-muted">Published</span>
                  <% elsif book.scheduled? %>
                    <span class="u-text-muted">Scheduled</span>
                  <% else %>
                    <span class="u-text-muted">Draft</span>
                  <% end %>
                </span>
              </li>
            <% end %>
          </ol>
          <% if can_manage %>
            <%# 8a: the series edit modal (7b), opened over the book page — no %>
            <%# trip to a series view (that destination is gone). %>
            <div class="u-cluster">
              <%= link_to "Reorder", edit_admin_series_path(primary.record), class: "u-link", data: { turbo_frame: "modal" } %>
              <span class="u-text-muted">or</span>
              <%= link_to "Move to another series", new_admin_book_shelving_path(@record), class: "u-link", data: { turbo_frame: "modal" } %>
            </div>
          <% end %>
        </section>
      <% end %>

      <%# A book already in a series manages its place via the list + "Reorder or
          move" link above; only a series-less book needs the add typeahead. %>
      <% if can_manage && !primary %>
        <%= render "admin/books/series_membership", record: @record, book: @book, heading: true %>
      <% end %>
    </div>

    <%# ── Right rail: collections + where to buy ── %>
    <aside class="book-detail__right u-flow" aria-label="Collections and stores">
      <section class="u-flow" aria-labelledby="collections-heading">
        <h2 id="collections-heading" class="subhead">Collections</h2>
        <p class="u-text-muted book-detail__note">Bundles this book appears in. Unlike the series, a book can sit in several, and a collection can mix series.</p>
        <% if can_manage %>
          <%= render "admin/books/collection_membership", record: @record, book: @book, heading: false %>
        <% else %>
          <% @book.collections.each do |collection| %>
            <p><%= link_to collection.title, admin_collection_path(collection.record) %>
              <span class="u-text-muted">· <%= pluralize(collection.books.count, "book") %><% if collection.unordered %> · unordered<% end %></span></p>
          <% end %>
        <% end %>
      </section>

      <section class="u-flow" aria-labelledby="buy-heading">
        <h2 id="buy-heading" class="subhead">Where to buy</h2>
        <% if can_manage %>
          <%= render "admin/distributors/section", record: @record, heading: false %>
        <% else %>
          <%= render "admin/distributors/list", record: @record %>
        <% end %>
      </section>
    </aside>
  </div>
</div>

<%# "Reorder" (series edit modal) and "Move to another series" (the picker) %>
<%# both open over the book page. %>
<%= turbo_frame_tag "modal" %>
