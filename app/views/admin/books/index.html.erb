<% content_for :title, "Books — Inkwell" %>

<%= render "admin/shared/canvas_head", crumbs: [["Books", nil]] %>

<div data-controller="filter" data-filter-unit-value="book">
  <header class="perma-header">
    <h1 class="perma-header__title">Books</h1>
    <div class="perma-header__content">
      <nav class="perma-header__toolbar" aria-label="Actions">
        <div class="filter-by-text">
          <input class="filter-by-text__input" type="search" placeholder=" " autocomplete="off"
                 aria-label="Filter books by title"
                 data-filter-target="input"
                 data-action="input->filter#apply keydown.esc->filter#clear">
          <label class="filter-by-text__hotkey">Filter… <kbd class="kbd">F</kbd></label>
        </div>
        <%= link_to new_admin_book_path, class: "button button--primary button--small" do %>
          <%= inline_svg_tag "lucide/plus.svg", class: "lucide", size: "16px" %> New book
        <% end %>
      </nav>
    </div>
  </header>

  <% if @archived_count.positive? %>
    <p class="u-margin-block-end"><%= link_to "View #{pluralize(@archived_count, "archived book")}", archived_admin_books_path %></p>
  <% end %>

  <% if @sections.any? %>
    <% @sections.each do |section_title, books| %>
      <section class="book-shelf" data-filter-target="section">
        <header class="book-shelf__head">
          <h2 class="book-shelf__title"><%= section_title %></h2>
          <span class="book-shelf__count" data-filter-target="count"><%= pluralize(books.size, "book") %></span>
        </header>
        <ul class="book-cards u-unlist">
          <% books.each do |book| %>
            <li class="book-card" data-filter-target="item" data-filter-text="<%= book.title.downcase %>">
              <%= link_to admin_book_path(book.record), class: "book-card__link" do %>
                <div class="book-card__cover">
                  <% if book.cover? %>
                    <%= image_tag book.cover, alt: "" %>
                  <% else %>
                    <span class="book-card__cover-blank u-center-content" aria-hidden="true"><%= book.title.first %></span>
                  <% end %>
                </div>
                <div class="book-card__body">
                  <h3 class="book-card__title"><%= book.title %></h3>
                  <p class="book-card__excerpt"><%= book.content.to_plain_text.to_s.truncate(700) %></p>
                  <p class="book-card__meta">
                    <% if book.published? %>
                      <span>Published <%= l((book.publication_date || book.published_at.to_date), format: :short) %></span>
                    <% elsif book.scheduled? %>
                      <span>Scheduled for <%= l(book.published_at, format: :short) %></span>
                    <% else %>
                      <span>Drafted <%= l(book.created_at.to_date, format: :short) %></span>
                    <% end %>
                  </p>
                </div>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
    <p class="book-shelf__blank" data-filter-target="blank" hidden>No books match.</p>
  <% else %>
    <div class="empty">
      <span class="empty__icon"><%= inline_svg_tag "lucide/inbox.svg", class: "lucide", size: "40px" %></span>
      <p class="empty__title">No books yet</p>
      <p class="empty__text">Add the first book to the catalog.</p>
      <div class="empty__actions"><%= link_to "New book", new_admin_book_path, class: "button button--primary" %></div>
    </div>
  <% end %>
</div>
