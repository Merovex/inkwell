<% content_for :title, "Archived messages — Inkwell" %>

<%= render "admin/shared/canvas_head", crumbs: [["Forum", admin_messages_path], ["Archived", nil]] %>

<header class="perma-header">
  <h1 class="perma-header__title">Archived messages</h1>
  <p class="perma-header__content u-text-muted">Set aside, but kept — open one to restore it.</p>
</header>

<%= render "admin/shared/archived_list", records: @messages,
      empty_text: "Archived messages are set aside here, out of the board." %>
