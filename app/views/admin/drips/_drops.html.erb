<%# locals: (record:, drops:, step_stats:) %>
<%# The campaign's steps: a drag-sortable timeline in send order, day 0 first. %>
<% if drops.any? %>
  <ol class="campaign-timeline sortable u-unlist" id="drip_drops" data-controller="sortable"
      data-sortable-url-value="<%= reorder_admin_drip_path(record) %>"
      data-sortable-param-value="drop_record_ids[]">
    <% previous = 0 %>
    <% drops.each_with_index do |drop, index| %>
      <%= render "admin/drips/drop_row", drip_record: record, drop: drop, index: index,
            previous: previous, stats: step_stats[drop.record_id] %>
      <% previous = drop.delay_days %>
    <% end %>
  </ol>
<% else %>
  <p class="u-text-muted">No steps yet — add the first email in the sequence.</p>
<% end %>
