<% content_for :title, "Categories — Inkwell" %>

<%= render "admin/shared/canvas_head", crumbs: [["Forum", admin_messages_path], ["Categories", nil]] %>

<header class="perma-header">
  <h1 class="perma-header__title">Categories</h1>
  <div class="perma-header__content">
    <nav class="perma-header__toolbar" aria-label="Actions">
      <%= link_to new_admin_category_path, class: "button button--primary button--small" do %>
        <%= inline_svg_tag "lucide/plus.svg", class: "lucide", size: "16px" %> New category
      <% end %>
    </nav>
  </div>
</header>

<% if @categories.any? %>
  <div class="list">
    <% @categories.each do |category| %>
      <%= render "shared/list_item",
            href: edit_admin_category_path(category),
            title: category.label,
            avatar: false,
            discard_path: admin_category_path(category),
            discard_aria: "Delete #{category.name}",
            discard_confirm: "Delete the “#{category.name}” category?" %>
    <% end %>
  </div>
<% else %>
  <div class="empty">
    <span class="empty__icon"><%= inline_svg_tag "lucide/inbox.svg", class: "lucide", size: "40px" %></span>
    <p class="empty__title">No categories</p>
    <p class="empty__text">Add one and it will be offered in the message composer.</p>
    <div class="empty__actions"><%= link_to "New category", new_admin_category_path, class: "button button--primary" %></div>
  </div>
<% end %>
