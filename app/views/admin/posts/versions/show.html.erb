<% content_for :title, "Version: #{@version.title}" %>

<%= render "admin/shared/canvas_head", crumbs: [["Posts", admin_posts_path], [@post.title, admin_post_path(@record)], ["Change Log", admin_post_events_path(@record)], ["Version", nil]] do %>
  <%= link_to "Change Log", admin_post_events_path(@record), class: "menu__item" %>
  <%= link_to "Back to post", admin_post_path(@record), class: "menu__item" %>
<% end %>

<header class="perma-header">
  <h1 class="perma-header__title"><%= @version.title %></h1>
  <p class="perma-header__content u-text-muted">
    Version from <%= version_timestamp(@version) %>
    by <span class="u-text-strong"><%= @version.creator.display_name %></span>
  </p>
</header>

<article class="u-flow">
  <%= @version.content %>
</article>
