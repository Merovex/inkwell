<% content_for :title, "Posts" %>

<%= render "admin/shared/canvas_head", crumbs: [["Posts", nil]], menu: false do %>
  <%= link_to new_admin_post_path, class: "button button--primary" do %>
    <%= inline_svg_tag "lucide/plus.svg", class: "lucide", size: "16px" %> New post
  <% end %>
<% end %>

<div data-controller="filter" data-filter-unit-value="post">
  <header class="perma-header">
    <h1 class="perma-header__title">Posts</h1>
    <div class="perma-header__content">
      <nav class="perma-header__toolbar" aria-label="Actions">
        <div class="filter-by-text">
          <input class="filter-by-text__input" type="search" placeholder=" " autocomplete="off"
                 aria-label="Filter posts by title"
                 data-filter-target="input"
                 data-action="input->filter#apply keydown.esc->filter#clear">
          <label class="filter-by-text__hotkey">Filter posts… <kbd class="kbd">F</kbd></label>
        </div>
      </nav>
    </div>
  </header>

  <% if (@drafts_count + @scheduled_count).positive? %>
    <p class="u-margin-block-end"><%= link_to unpublished_work_label(@drafts_count, @scheduled_count, noun: "post"), admin_drafts_path %></p>
  <% end %>
  <% if @archived_count.positive? %>
    <p class="u-margin-block-end"><%= link_to "View #{pluralize(@archived_count, "archived post")}", archived_admin_posts_path %></p>
  <% end %>

  <% if @posts.any? %>
    <div class="list" data-filter-target="section">
      <% @posts.each do |post| %>
        <%# The body is read twice per row (excerpt + length) — parse it once. %>
        <% body = plain_text(post.content) %>
        <%= render "shared/list_item",
              href: admin_post_path(post.record),
              title: post.title,
              avatar: false,
              author: post.record.creator.display_name,
              date: l(post.published_at.to_date, format: :short),
              length: post_length(body),
              trailing_chips: post_status_chips(post),
              excerpt: plain_excerpt(body),
              comment_count: @comment_counts[post.record_id].to_i,
              pinned: post.pinned_at.present?,
              filter_text: "#{post.title} #{post.record.creator.display_name}".downcase %>
      <% end %>
    </div>
    <p class="u-text-muted u-margin-block-end" data-filter-target="blank" hidden>No posts match.</p>
  <% else %>
    <div class="empty">
      <span class="empty__icon"><%= inline_svg_tag "lucide/inbox.svg", class: "lucide", size: "40px" %></span>
      <p class="empty__title">No posts yet</p>
      <p class="empty__text">Write the first post and it will show up here.</p>
      <div class="empty__actions"><%= link_to "New post", new_admin_post_path, class: "button button--primary" %></div>
    </div>
  <% end %>
</div>
