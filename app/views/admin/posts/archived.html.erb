<% content_for :title, "Archived posts — Inkwell" %>

<%= render "admin/shared/canvas_head", crumbs: [["Posts", admin_posts_path], ["Archived", nil]] %>

<header class="perma-header">
  <h1 class="perma-header__title">Archived posts</h1>
  <p class="perma-header__content u-text-muted">Set aside, but kept — open one to restore it.</p>
</header>

<%= render "admin/shared/archived_list", records: @posts,
      empty_text: "Archived posts are set aside here, out of the main feed." %>
