<%# locals: (post:, url:) %>
<%= render "admin/shared/error_summary", model: post %>

<%# Borderless composer: no visible labels (accessible names via aria-label). %>
<%# Submits from the canvas-head buttons (form: "composer"). %>
<%# Autosaved to localStorage: new posts share the posts/new draft slot; %>
<%# edits key to the record, guarded by the current version id. %>
<%= form_with model: post, url: url, id: "composer", class: "composer",
      data: { controller: "autosave word-count",
              autosave_key_value: (post.record_id ? "Record/#{post.record_id}/edit" : "posts/new"),
              autosave_revision_value: post.record&.recordable_id,
              word_count_words_per_minute_value: ApplicationHelper::WORDS_PER_MINUTE } do |f| %>
  <%= f.text_field :title, class: "composer__title", placeholder: "Post title",
        "aria-label": "Title", required: true, autofocus: true %>

  <%# Metadata (summary + byline) rides above the body so the body can be the
      last element and grow to fill the viewport. %>
  <%# Optional plain-text summary for the blog list + search results; falls back %>
  <%# to a truncation of the body when blank (Post#summary). The counter nudges %>
  <%# toward the 50–160 search-snippet sweet spot. %>
  <div class="composer__field" data-controller="char-count"
       data-char-count-min-value="50" data-char-count-max-value="160">
    <%= f.text_area :excerpt, class: "composer__excerpt u-surface", rows: 2, maxlength: 160,
          placeholder: "Optional summary for the blog list and search results…",
          "aria-label": "Excerpt",
          data: { char_count_target: "field", action: "input->char-count#update" } %>
    <p class="composer__hint u-text-muted">
      <span data-char-count-target="count">0</span>/160 — aim for 50–160 characters, with your keywords in the first 120.
    </p>
  </div>

  <%= render "admin/shared/author_select", f: f, resource: post %>

  <%# The body, and under it a live word count + reading estimate (word-count
      controller), worded exactly like post_length on the index and post pages.
      The hint is a sibling, not a wrapper: .composer lexxy-editor flex-grows to
      fill the canvas and a wrapper div would swallow that. %>
  <%= f.rich_textarea :content, placeholder: "Write away…", "aria-label": "Body",
        data: { word_count_target: "source", action: "lexxy:change->word-count#update lexxy:initialize->word-count#update" } %>
  <p class="composer__hint u-text-muted"><span data-word-count-target="output">0 words</span></p>
<% end %>
