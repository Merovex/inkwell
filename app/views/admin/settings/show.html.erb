<% content_for :title, "System settings" %>

<%= render "admin/shared/canvas_head", crumbs: [["System settings", nil]] %>

<header class="perma-header">
  <h1 class="perma-header__title">System settings</h1>
</header>

<div class="settings u-stack u-stack-double u-margin-block-start settings--wide u-center">
  <%# The site identity — the public Merovex Press face. One form; every panel's
      fields save together on Save (hidden panels still submit). The segmented
      control (segmented_tabs helper) tabs between panels so the long legal copy
      doesn't stack into one endless page. %>
  <section class="settings__section" aria-label="Site identity">
    <%= render "admin/shared/error_summary", model: @site %>

    <%# The logo well is its OWN form (settings/logo) and saves the moment a
        file is picked or dropped — the avatar-well pattern. It sits outside
        the settings form below (forms can't nest), so an upload can never
        collide with that form's Save or a removal. %>
    <%= form_with url: admin_settings_logo_path, method: :patch, multipart: true, class: "field logo-upload",
          data: { controller: "avatar-upload",
                  action: "dragover->avatar-upload#dragover dragleave->avatar-upload#dragleave drop->avatar-upload#drop" } do %>
      <% if @site.logo.attached? %>
        <%= render "shared/logo", site: @site, class_name: "logo-upload__preview", label: "Current logo" %>
      <% else %>
        <span class="logo-upload__placeholder" aria-hidden="true">No logo</span>
      <% end %>
      <label class="button">
        <%= @site.logo.attached? ? "Change logo…" : "Upload a logo…" %>
        <%= file_field_tag "site[logo]", accept: Site::LOGO_CONTENT_TYPES.join(","), hidden: true,
              "aria-label": "Upload logo",
              data: { avatar_upload_target: "input", action: "change->avatar-upload#submit" } %>
      </label>
      <p class="field__hint u-text-muted">Shown in the public site header. Click the button or drop an image — it saves immediately. JPG, PNG, AVIF, WebP, or SVG, up to <%= Site::LOGO_MAX_SIZE / 1.megabyte %> MB.</p>
    <% end %>
    <% if @site.logo.attached? %>
      <%= button_to "Remove logo and use the wordmark", admin_settings_logo_path, method: :delete, class: "button" %>
    <% end %>

    <%# dirty-form: Save wakes up only once something changes. %>
    <%= form_with model: @site, url: admin_settings_path, method: :patch, class: "u-full-width",
          data: { controller: "dirty-form", action: "input->dirty-form#dirty change->dirty-form#dirty" } do |f| %>
      <% identity_panel = capture do %>
        <div class="field-row">
          <div class="field">
            <%= f.label :site_name, "Site name", class: "field__label" %>
            <%= f.text_field :site_name, class: "field__control", placeholder: "Merovex Press", required: true %>
            <p class="field__hint u-text-muted">The name in the browser tab, public header, and footer.</p>
          </div>

          <%# The account's Kindred Quill name (delegated through Site): the
              platform URL segment and the shared sending address's local part.
              The handle-check controller asks /admin/handle_availability as you
              type and counter-offers a free variant when taken. %>
          <div class="field" data-controller="handle-check"
               data-handle-check-url-value="<%= admin_handle_availability_path %>">
            <%= f.label :handle, "Handle", class: "field__label" %>
            <%= f.text_field :handle, class: "field__control", placeholder: "yourname",
                  autocapitalize: "off", autocorrect: "off", spellcheck: "false",
                  data: { handle_check_target: "input", action: "input->handle-check#check" } %>
            <p class="field__hint u-text-muted">Your Kindred Quill name — your site lives at
               <code><%= Rails.configuration.x.cloudflare.cname_target %>/<%= @site.handle.presence || "yourname" %></code>
               and newsletters can send from <code><%= @site.handle.presence || "yourname" %>@<%= Account.shared_sending_domain %></code>.</p>
            <p class="field__hint" data-handle-check-target="status" aria-live="polite" hidden></p>
            <button type="button" class="button" hidden
                    data-handle-check-target="suggest" data-action="handle-check#applySuggestion"></button>
          </div>
        </div>

        <div class="field-row">
          <div class="field">
            <%= f.label :tagline, "Tagline", class: "field__label" %>
            <%= f.text_field :tagline, class: "field__control", placeholder: "A one-line description" %>
            <p class="field__hint u-text-muted">Sits beside the site name in the page title.</p>
          </div>

          <div class="field">
            <%= f.label :contact_email, "Contact email", class: "field__label" %>
            <%= f.email_field :contact_email, class: "field__control", placeholder: "hello@merovex.press" %>
            <p class="field__hint u-text-muted">Where the public footer's contact link points.</p>
          </div>
        </div>
      <% end %>

      <%# Pages, Domain, and Email are sibling pages in the same control (their
          own forms can't nest inside this one); ?tab= deep-links back from
          them. The About/Privacy/Terms copy that used to be edited here lives
          on those Pages now. %>
      <%= segmented_tabs [
            { id: "identity", label: "Identity", panel: identity_panel },
            { id: "pages", label: "Pages", href: admin_pages_path },
            { id: "domain", label: "Domain", href: admin_custom_domains_path },
            { id: "email", label: "Email", href: admin_sending_domains_path },
          ], aria_label: "Settings sections", selected: params[:tab] %>

      <div class="form__action">
        <%= f.submit "Save", class: "button button--primary", data: { dirty_form_target: "submit" } %>
      </div>
    <% end %>
  </section>
</div>
