<% content_for :title, "System settings — Inkwell" %>

<%= render "admin/shared/canvas_head", crumbs: [["System settings", nil]] %>

<header class="perma-header">
  <h1 class="perma-header__title">System settings</h1>
</header>

<div class="settings u-stack u-stack-double u-margin-block-start settings--wide u-center">
  <%# The site identity — the public Merovex Press face. One form; every panel's
      fields save together on Save (hidden panels still submit). The segmented
      control (segmented_tabs helper) tabs between panels so the long legal copy
      doesn't stack into one endless page. %>
  <section class="settings__section" aria-label="Site identity">
    <%= render "admin/shared/error_summary", model: @site %>

    <%= form_with model: @site, url: admin_settings_path, method: :patch, multipart: true, class: "u-full-width" do |f| %>
      <% identity_panel = capture do %>
        <div class="field logo-upload">
          <% if @site.logo.attached? %>
            <%= image_tag @site.logo, class: "logo-upload__preview", alt: "Current logo" %>
          <% else %>
            <span class="logo-upload__placeholder" aria-hidden="true">No logo</span>
          <% end %>
          <%# A styled label opens the (hidden) picker — like the avatar control. %>
          <label class="button">
            <%= @site.logo.attached? ? "Change logo…" : "Upload a logo…" %>
            <%= f.file_field :logo, accept: Site::LOGO_CONTENT_TYPES.join(","), hidden: true %>
          </label>
          <% if @site.logo.attached? %>
            <label class="logo-upload__remove">
              <%= check_box_tag "site[remove_logo]", "1" %>
              Remove logo and use the wordmark
            </label>
          <% end %>
          <p class="field__hint u-text-muted">Shown in the public site header. JPG, PNG, AVIF, WebP, or SVG, up to <%= Site::LOGO_MAX_SIZE / 1.megabyte %> MB.</p>
        </div>

        <div class="field">
          <%= f.label :site_name, "Site name", class: "field__label" %>
          <%= f.text_field :site_name, class: "field__control", placeholder: "Merovex Press", required: true %>
          <p class="field__hint u-text-muted">The name in the browser tab, public header, and footer.</p>
        </div>

        <div class="field">
          <%= f.label :tagline, "Tagline", class: "field__label" %>
          <%= f.text_field :tagline, class: "field__control", placeholder: "A one-line description" %>
          <p class="field__hint u-text-muted">Sits beside the site name in the page title.</p>
        </div>

        <div class="field">
          <%= f.label :contact_email, "Contact email", class: "field__label" %>
          <%= f.email_field :contact_email, class: "field__control", placeholder: "hello@merovex.press" %>
          <p class="field__hint u-text-muted">Where the public footer's contact link points.</p>
        </div>
      <% end %>

      <% about_panel = capture do %>
        <div class="field">
          <%= f.rich_textarea :description, placeholder: "About the site…", "aria-label": "About" %>
          <p class="field__hint u-text-muted">Feeds the public page description; a plain-text summary is used where formatting can't render.</p>
        </div>
      <% end %>

      <% privacy_panel = capture do %>
        <div class="field">
          <%= f.rich_textarea :privacy_policy, placeholder: "Your privacy policy (include your cookie notice here)…", "aria-label": "Privacy policy" %>
          <p class="field__hint u-text-muted">Published at /privacy; leave blank to hide the footer link. Include your cookie notice here.</p>
        </div>
      <% end %>

      <% terms_panel = capture do %>
        <div class="field">
          <%= f.rich_textarea :terms, placeholder: "Your terms of service…", "aria-label": "Terms of service" %>
          <p class="field__hint u-text-muted">Published at /terms; leave blank to hide the footer link.</p>
        </div>
      <% end %>

      <%# Domain and Email are sibling pages in the same control (their
          connect/disconnect forms can't nest inside this form); ?tab=
          deep-links back from them. %>
      <%= segmented_tabs [
            { id: "identity", label: "Identity", panel: identity_panel },
            { id: "about", label: "About", panel: about_panel },
            { id: "privacy", label: "Privacy", panel: privacy_panel },
            { id: "terms", label: "Terms", panel: terms_panel },
            { id: "domain", label: "Domain", href: admin_custom_domains_path },
            { id: "email", label: "Email", href: admin_sending_domains_path },
          ], aria_label: "Settings sections", selected: params[:tab] %>

      <%= f.submit "Save", class: "button button--primary" %>
    <% end %>
  </section>
</div>
