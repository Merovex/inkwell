<%# locals: (boost:, removable: true) %>
<%# One boost badge: the booster's mini avatar + their words. Your own badge %>
<%# carries a circle-x to take it back; anyone else's is inert. removable: %>
<%# false renders every badge inert — read-only surfaces (the wall cards), %>
<%# where the remove redirect would navigate away. %>
<span class="badge boost" title="<%= boost.creator.display_name %>">
  <span class="avatar boost__avatar" aria-hidden="true"><%= avatar_content(boost.creator) %></span>
  <%= boost.content %>
  <% if removable && boost.creator == Current.user %>
    <%= button_to boost_path_for(boost), method: :delete, class: "boost__remove u-unbutton",
          form: { class: "boost__form" }, title: "Remove your boost", aria: { label: "Remove your boost" } do %>
      <%= inline_svg_tag "lucide/circle-x.svg", class: "lucide", size: "14px" %>
    <% end %>
  <% end %>
</span>
