<%# locals: (records:, empty_text: "Archived items are set aside here, out of the main list.") %>
<%# A list of archived recordables (posts, messages, …), each linking back to
<%# its own page to be restored. Rows reuse the standard list_item; the href
<%# resolves per type via record_show_path, so this stays parent-agnostic. %>
<% if records.any? %>
  <ul class="list">
    <% records.each do |recordable| %>
      <%= render "admin/shared/list_item",
            href: record_show_path(recordable.record),
            title: recordable.try(:title).presence || "Untitled",
            author: recordable.record.creator.display_name,
            avatar_user: recordable.record.creator,
            date: l((recordable.try(:published_at) || recordable.created_at).to_date, format: :short),
            excerpt: (recordable.content.to_plain_text.to_s.truncate(140) if recordable.respond_to?(:content)) %>
    <% end %>
  </ul>
<% else %>
  <div class="empty">
    <span class="empty__icon"><%= inline_svg_tag "lucide/inbox.svg", class: "lucide", size: "40px" %></span>
    <p class="empty__title">Nothing archived</p>
    <p class="empty__text"><%= empty_text %></p>
  </div>
<% end %>
