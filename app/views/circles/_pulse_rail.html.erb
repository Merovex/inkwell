<%# locals: (circle:, record:, pulse:, answered_this_week:, answered_ids:, members:) %>
<%# The Pulse checks rail: this week's completion + close, your run, and the
    members with their In/Nudge state. Reuses the .circle-rail column shell,
    the shared .stat big-number, .meter bar, and .run__bars sparkline. %>
<aside class="circle-rail" aria-label="Pulse check">
  <section class="circle-rail__section" aria-labelledby="rail-week">
    <h2 id="rail-week" class="circle-rail__heading u-microcaps u-text-muted">This week</h2>
    <dl class="stat stat--compact">
      <dt class="stat__label">of <%= pulse.subscriber_count %> answered</dt>
      <dd class="stat__value"><%= answered_this_week %></dd>
    </dl>
    <progress class="meter" value="<%= answered_this_week %>" max="<%= [ pulse.subscriber_count, 1 ].max %>"><%= answered_this_week %> of <%= pulse.subscriber_count %></progress>
    <p class="pulse-close">Closes <%= Date.current.end_of_week.strftime("%A") %>, <%= pulse.ask_at %></p>
  </section>

  <section class="circle-rail__section" aria-labelledby="rail-run">
    <h2 id="rail-run" class="circle-rail__heading u-microcaps u-text-muted">Your run</h2>
    <% weeks = pulse.weeks_answered(Current.user) %>
    <dl class="stat stat--compact">
      <dt class="stat__label">weeks answered</dt>
      <dd class="stat__value"><%= weeks.count { |_, answered| answered } %></dd>
    </dl>
    <span class="run__bars" aria-hidden="true">
      <% weeks.each do |week, answered| %>
        <span class="run__bar<%= " run__bar--on" if answered %>"
              title="Week <%= week.cweek %> (<%= l week, format: :short %>) — <%= answered ? "answered" : "no answer" %>"></span>
      <% end %>
    </span>
  </section>

  <section class="circle-rail__section" aria-labelledby="rail-members">
    <h2 id="rail-members" class="circle-rail__heading u-microcaps u-text-muted">Members</h2>
    <ul class="pulse-members">
      <% members.each do |member| %>
        <li class="pulse-members__row">
          <span class="avatar avatar--small" aria-hidden="true"><%= avatar_content(member) %></span>
          <span class="pulse-members__name"><%= member.display_name %></span>
          <% if answered_ids.include?(member.id) %>
            <span class="pulse-members__in u-text-strong">In</span>
          <% elsif member.id == Current.user.id %>
            <span class="u-text-muted">—</span>
          <% else %>
            <%= button_to "Nudge", circle_pulse_nudges_path(circle, record, member_id: member.id),
                  class: "u-unbutton pulse-members__nudge u-text-strong" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
</aside>
