<%# locals: (circle:, record:, message:, comment_count:, commenters:, boosts:) %>
<%# One feed story: an avatar·name·when byline, then the title (the door to the
    thread), the clamped rich body, and the commenters' faces + count + boost
    chips — title and body flush to the card's edge, not indented under the
    avatar. A ⋯ context menu for whoever may act on it. Cached on the version +
    author + count + commenters + boosts + the viewer's CAPABILITIES (not
    identity), so the menu never leaks across roles but same-role viewers share
    one fragment. %>
<% can_edit = record.editable_by?(Current.user) %>
<% can_trash = record.moderatable_by?(Current.user) %>
<% cache [ "wall-card", message, record.creator, comment_count, commenters, boosts, can_edit, can_trash ] do %>
  <article class="wall__card">
    <header class="wall__byline">
      <span class="avatar wall__avatar" aria-hidden="true"><%= avatar_content(record.creator) %></span>
      <span class="u-text-strong"><%= record.creator.display_name %></span>
      <span class="wall__meta wall__when">· <%= time_ago_tag(message.published_at || message.created_at) %></span>
      <% if can_edit || can_trash %>
        <div class="wall__actions">
          <button type="button" class="button button--icon button--ghost"
                  popovertarget="wall-menu-<%= record.id %>" aria-label="Message actions">
            <%= inline_svg_tag "lucide/ellipsis-vertical.svg", class: "lucide", size: "18px" %>
          </button>
          <div class="menu" popover id="wall-menu-<%= record.id %>" data-controller="anchored-popover">
            <% if can_edit %>
              <%# Opens the edit composer in the feed's modal. %>
              <%= link_to "Edit", circle_wall_edit_path(circle, record), class: "menu__item",
                    data: { turbo_frame: "modal" } %>
            <% end %>
            <% if can_trash %>
              <% if can_edit %><hr class="menu__separator"><% end %>
              <%= button_to "Move to trash", circle_message_path(circle, record), method: :delete,
                    class: "menu__item",
                    form: { data: { turbo_confirm: "Move “#{message.title}” to the trash?" } } %>
            <% end %>
          </div>
        </div>
      <% end %>
    </header>
    <h3 class="wall__title"><%= link_to message.title, circle_wall_thread_path(circle, record),
          data: { turbo_frame: "modal" } %></h3>
    <div class="prose u-clamp wall__body"><%= message.content %></div>
    <footer class="wall__footer">
      <%# Who's in the thread — distinct commenters, overlapping faces. %>
      <% if commenters.any? %>
        <%= render "shared/avatar_group", users: commenters, limit: 3, size: "small" %>
      <% end %>
      <%# Opens the thread modal; live comment broadcasts replace it in place. %>
      <%= render "circles/walls/comment_count", record: record, count: comment_count %>
      <%# The boosts themselves, read-only — boosting happens in the thread
          modal. Always-rendered container: live broadcasts append here. %>
      <span class="wall__chips" id="<%= dom_id(record, :wall_boosts) %>">
        <%= render partial: "circles/walls/boost_chip", collection: boosts, as: :boost %>
      </span>
    </footer>
  </article>
<% end %>
