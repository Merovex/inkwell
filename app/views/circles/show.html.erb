<% content_for :title, "#{@circle.name} — Circle" %>

<%= render "admin/shared/canvas_head", crumbs: [["Circles", circles_path], [@circle.name, nil]],
      edit_href: (edit_circle_path(@circle) if allowed_to?(:manage, @circle)) do %>
  <%# The membership page: roster + invitations (any member may invite). %>
  <%= link_to "Membership", circle_members_path(@circle), class: "menu__item" %>
  <% unless allowed_to?(:manage, @circle) %>
    <hr class="menu__separator">
    <%# A member's own exit (Basecamp's "Leave this project"). Owners never
        see it — they delete or hand off, they don't abandon. %>
    <%= button_to "Leave this circle", circle_membership_path(@circle), method: :delete,
          class: "menu__item",
          form: { data: { turbo_confirm: "Leave #{@circle.name}? You'll need a new invitation to return." } } %>
  <% end %>
<% end %>

<header class="perma-header">
  <h1 class="perma-header__title"><%= @circle.name %></h1>
  <p class="perma-header__content u-text-muted">
    <span class="u-text-strong"><%= @circle.owner.display_name %></span>
    · <%= pluralize(@circle.circle_memberships.count, "member") %>
    <%= render "shared/avatar_group", users: @members, limit: 10, size: "small" %>
  </p>
  <% if @circle.description.present? %>
    <p class="perma-header__content"><%= @circle.description %></p>
  <% end %>
</header>

<section class="circle-section" aria-labelledby="pulse-heading">
  <div class="u-cluster u-cluster-between u-margin-block-end-double">
    <h2 id="pulse-heading">Pulse check</h2>
    <% if @pulse.nil? && allowed_to?(:manage, @circle) %>
      <%= link_to new_circle_pulse_path(@circle), class: "button button--primary button--small" do %>
        <%= inline_svg_tag "lucide/plus.svg", class: "lucide", size: "16px" %> Set up a Pulse check
      <% end %>
    <% end %>
  </div>

  <% if @pulse %>
    <%# The whole element is a door to the pulse page: the question, its
        schedule, and — when there are answers — the latest three as preview
        cards (a taste of the answer, the face, the freshness). %>
    <%= link_to circle_pulse_path(@circle, @pulse.record), class: "pulse-preview" do %>
      <span class="pulse-preview__question"><%= @pulse.question %></span>
      <span class="pulse-preview__schedule">Asked <%= @pulse.schedule_summary %> at <%= @pulse.ask_at %></span>
      <% if @pulse_beats.any? %>
        <span class="pulse-preview__answers">
          <% @pulse_beats.each do |beat| %>
            <span class="pulse-preview__card">
              <span class="pulse-preview__byline">
                <span class="avatar" aria-hidden="true"><%= avatar_content(beat.creator) %></span>
                <%= beat.creator.display_name %> · <%= time_ago_in_words(beat.record.created_at) %> ago
              </span>
              <span class="pulse-preview__excerpt"><%= plain_excerpt(beat.content, length: 110) %></span>
            </span>
          <% end %>
          <%# Empty slots hold the shape — one answer still reads as a row
              with room for more. %>
          <% (3 - @pulse_beats.size).times do %>
            <span class="pulse-preview__ghost" aria-hidden="true"></span>
          <% end %>
        </span>
      <% end %>
    <% end %>
  <% else %>
    <p class="u-text-muted">No Pulse check yet.</p>
  <% end %>
</section>

<section class="circle-section" aria-labelledby="discussions-heading">
  <div class="u-cluster u-cluster-between u-margin-block-end-double">
    <h2 id="discussions-heading">Discussions</h2>
    <%= link_to new_circle_message_path(@circle), class: "button button--primary button--small" do %>
      <%= inline_svg_tag "lucide/plus.svg", class: "lucide", size: "16px" %> New message
    <% end %>
  </div>

  <% if @discussions.any? %>
    <%= render "circles/messages/discussions", circle: @circle, discussions: @discussions %>

    <% if @discussions_count > CirclesController::PREVIEW_COUNT %>
      <p class="section-more">
        <%= link_to "See all #{pluralize(@discussions_count, "discussion")}", circle_messages_path(@circle) %>
      </p>
    <% end %>
  <% else %>
    <p class="u-text-muted">No discussions yet. Start the first one.</p>
  <% end %>
</section>

<%# Membership (roster, invites, pending seats) lives on its own page —
    the ⋯ menu's "Membership"; the header's avatar cluster is the preview. %>
