<% content_for :title, "#{@circle.name} — Circle" %>

<%= render "admin/shared/canvas_head", crumbs: [["Circles", circles_path], [@circle.name, nil]],
      edit_href: (edit_circle_path(@circle) if allowed_to?(:manage, @circle)) %>

<header class="perma-header">
  <h1 class="perma-header__title"><%= @circle.name %></h1>
  <p class="perma-header__content u-text-muted">
    <span class="u-text-strong"><%= @circle.owner.display_name %></span>
    · <%= pluralize(@circle.circle_memberships.count, "member") %>
  </p>
  <% if @circle.description.present? %>
    <p class="perma-header__content"><%= @circle.description %></p>
  <% end %>
</header>

<section aria-labelledby="pulse-heading">
  <div class="section-head">
    <h2 class="section-head__title" id="pulse-heading">Pulse check</h2>
    <% if @pulse.nil? && allowed_to?(:manage, @circle) %>
      <%= link_to new_circle_pulse_path(@circle), class: "button button--primary button--small" do %>
        <%= inline_svg_tag "lucide/plus.svg", class: "lucide", size: "16px" %> Set up a Pulse check
      <% end %>
    <% end %>
  </div>

  <% if @pulse %>
    <ul class="list">
      <li class="list__item">
        <a href="<%= circle_pulse_path(@circle, @pulse.record) %>" class="list__body">
          <span class="list__titlerow"><span class="list__title"><%= @pulse.question %></span></span>
          <span class="list__meta"><span class="list__byline">Asked <%= @pulse.schedule_summary %> at <%= @pulse.ask_at %></span></span>
        </a>
      </li>
    </ul>
  <% else %>
    <p class="u-text-muted">No Pulse check yet.</p>
  <% end %>
</section>

<section aria-labelledby="discussions-heading">
  <div class="section-head">
    <h2 class="section-head__title" id="discussions-heading">Discussions</h2>
    <%= link_to new_circle_message_path(@circle), class: "button button--primary button--small" do %>
      <%= inline_svg_tag "lucide/plus.svg", class: "lucide", size: "16px" %> New message
    <% end %>
  </div>

  <% if @discussions.any? %>
    <%= render "circles/messages/discussions", circle: @circle, discussions: @discussions %>

    <% if @discussions_count > CirclesController::PREVIEW_COUNT %>
      <p class="section-more">
        <%= link_to "See all #{pluralize(@discussions_count, "discussion")}", circle_messages_path(@circle) %>
      </p>
    <% end %>
  <% else %>
    <p class="u-text-muted">No discussions yet. Start the first one.</p>
  <% end %>
</section>
