<%# locals: (frame_id:) %>
<%# The feed's paginated card frame — message + beat cards newest-first, then a
    lazy load-more frame. Reads @items / @records_by_message / @beat_records /
    @pulse_records / @comment_counts / @commenters_by_record / @boosts_by_record
    / @more / @cursor. The empty state shows only on the first page. %>
<%= turbo_frame_tag frame_id, target: "_top" do %>
  <% @items.each do |item| %>
    <% if (message = item[:message]) %>
      <% record = @records_by_message[message] %>
      <%= render "circles/walls/card", circle: @circle, record: record, message: message,
            comment_count: @comment_counts[record.id].to_i,
            commenters: @commenters_by_record.fetch(record.id, []),
            boosts: @boosts_by_record.fetch(record.id, []) %>
    <% else %>
      <% beat = item[:beat] %>
      <% record = @beat_records[beat.record_id] %>
      <%= render "circles/walls/beat_card", circle: @circle, record: record, beat: beat,
            pulse_record: @pulse_records[record.parent_id],
            comment_count: @comment_counts[record.id].to_i,
            commenters: @commenters_by_record.fetch(record.id, []),
            boosts: @boosts_by_record.fetch(record.id, []) %>
    <% end %>
  <% end %>
  <% if @items.empty? && params[:before_id].blank? %>
    <p class="u-text-muted">Nothing posted yet — start the first post.</p>
  <% end %>
  <% if @more %>
    <%# Scrolling this into view fetches the next page; its response's matching
        frame replaces the placeholder. %>
    <%= turbo_frame_tag "wall-page-#{@cursor}", target: "_top", loading: :lazy,
          src: circle_path(@circle, before_id: @cursor) do %>
      <p class="u-text-muted">Loading more…</p>
    <% end %>
  <% end %>
<% end %>
