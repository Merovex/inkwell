<% content_for :title, "Archived discussions — #{@circle.name}" %>

<%= render "admin/shared/canvas_head",
      crumbs: [["Circles", circles_path], [@circle.name, circle_path(@circle)],
               ["Discussions", circle_messages_path(@circle)], ["Archived", nil]] %>

<header class="perma-header">
  <h1 class="perma-header__title">Archived discussions</h1>
  <p class="perma-header__content u-text-muted">Set aside, but kept — open one to restore it.</p>
</header>

<% if @discussions.any? %>
  <%= render "discussions", circle: @circle, discussions: @discussions %>
<% else %>
  <div class="empty">
    <span class="empty__icon"><%= inline_svg_tag "lucide/inbox.svg", class: "lucide", size: "40px" %></span>
    <p class="empty__title">Nothing archived</p>
    <p class="empty__text">Archived discussions are set aside here, out of the main list.</p>
  </div>
<% end %>
