<%# locals: (message:, url:) %>
<%= render "admin/shared/error_summary", model: message %>

<%# Borderless composer, same as the forum/posts: no visible labels (accessible
<%# names via aria-label), submits from the canvas-head buttons (form:
<%# "composer"). Trimmed for circles — no category, excerpt, or author. %>
<%= form_with model: message, url: url, id: "composer", class: "composer",
      data: { controller: "autosave",
              autosave_key_value: (message.record_id ? "Record/#{message.record_id}/edit" : "circles/#{@circle.id}/messages/new"),
              autosave_revision_value: message.record&.recordable_id } do |f| %>
  <%= f.text_field :title, class: "composer__title", placeholder: "Type a title…",
        "aria-label": "Title", required: true, autofocus: true %>

  <%= f.rich_textarea :content, placeholder: "Write away…", "aria-label": "Body" %>
<% end %>
