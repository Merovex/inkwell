<%# locals: (circle:, discussions:) %>
<%# A list of discussion rows (shared by the index and the archived view), each
<%# linking to its own page. Scheduled rows carry the built-in "Posts on…" flag
<%# (they're only visible to their author and the circle owner anyway). %>
<ul class="list">
  <% discussions.each do |discussion| %>
    <%= render "admin/shared/list_item",
          href: circle_message_path(circle, discussion.record),
          title: discussion.title,
          author: discussion.creator.display_name,
          avatar_user: discussion.creator,
          date: l(discussion.created_at.to_date, format: :short),
          excerpt: discussion.content.to_plain_text.to_s.truncate(140),
          scheduled_at: (discussion.published_at if discussion.scheduled?) %>
  <% end %>
</ul>
