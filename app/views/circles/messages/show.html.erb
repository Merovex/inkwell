<% content_for :title, "#{@message.title} — #{@circle.name}" %>

<%= render "admin/shared/canvas_head",
      crumbs: [["Circles", circles_path], [@circle.name, circle_path(@circle)],
               ["Discussions", circle_messages_path(@circle)], [@message.title, nil]],
      edit_href: (edit_circle_message_path(@circle, @record) if editable?) do %>
  <button type="button" class="menu__item"
          data-controller="clipboard" data-action="clipboard#copy"
          data-clipboard-text-value="<%= circle_message_url(@circle, @record) %>"
          popovertarget="canvas-menu" popovertargetaction="hide">Copy link</button>
  <% if moderatable? %>
    <hr class="menu__separator">
    <% if @record.archived? %>
      <%= button_to "Unarchive", unarchive_circle_message_path(@circle, @record), method: :patch, class: "menu__item" %>
    <% else %>
      <%= button_to "Archive", archive_circle_message_path(@circle, @record), method: :patch, class: "menu__item" %>
    <% end %>
    <%= button_to "Move to trash", circle_message_path(@circle, @record), method: :delete, class: "menu__item" %>
  <% end %>
<% end %>

<header class="perma-header u-center u-center-prose">
  <p class="perma-header__content u-microcaps u-text-muted">
    <%= link_to @circle.name, circle_path(@circle) %> · Message board
  </p>
  <h1 class="perma-header__title"><%= @message.title %></h1>
  <p class="perma-header__content u-text-muted">
    <span class="avatar" aria-hidden="true"><%= avatar_content(@record.creator) %></span>
    <span class="u-text-strong"><%= @record.creator.display_name %></span>
    <% if @message.published? %>
      · <%= l @message.published_at.to_date, format: :long %>
    <% elsif @message.scheduled? %>
      · <span class="badge badge--accent">Scheduled ·
        <time datetime="<%= @message.published_at.iso8601 %>" data-controller="local-time"
              data-local-time-datetime-value="<%= @message.published_at.iso8601 %>"><%= @message.published_at.strftime("%b %-d at %H:%M") %></time></span>
    <% else %>
      · <span class="badge">Draft</span>
    <% end %>
    <% if @record.archived? %>
      · <span class="badge">Archived</span>
    <% end %>
  </p>
</header>

<article class="prose">
  <%= mentions_highlighted(@message.content, @record) %>
</article>

<div class="u-center u-center-prose">
  <%= render "admin/boosts/boosts", record: @record %>
</div>

<div class="u-center u-center-prose">
  <%= render "admin/comments/comments", record: @record %>
</div>
