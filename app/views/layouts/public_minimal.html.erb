<!DOCTYPE html>
<html lang="en" data-theme="<%= press_theme %>">
  <head>
    <title><%= content_for(:title) || site_settings.site_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="robots" content="noindex">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">

    <%# Tokens + the press look, the shell/type utilities the claim and notice
        pages compose (press-shell's prose measure, u-flow rhythm), and
        u-visually-hidden — the honeypot on the renewal form hides with it. %>
    <%= stylesheet_link_tag "01-tokens", "press-fonts", "press-base",
          "press-controls", "press-notice", "press-utilities",
          "u-flow", "u-visually-hidden", "data-turbo-track": "reload" %>
  </head>

  <%# A single centered card on the page background — no nav, no footer. %>
  <body class="press press-notice-page">
    <main class="press-notice-wrap"><%= yield %></main>
  </body>
</html>
