<%# App header — brand left; notifications + user menu top-right. %>
<%# .app-header is hidden under Hotwire Native (native nav takes over). %>
<header class="bar app-header">
  <%# In a site's admin (slug in SCRIPT_NAME) home is that site's admin root; %>
  <%# on the bare app host admin_root_path would emit a slugless /admin (404), %>
  <%# so home falls back to where sign-in lands you (default_admin_url). %>
  <%= link_to (Current.account ? admin_root_path : default_admin_url), class: "app-header__home", aria: { label: "Home" } do %>
    <%= inline_svg_tag "lucide/house.svg", class: "lucide", size: "20px" %>
  <% end %>
  <button type="button" class="bar__brand app-menu-trigger" popovertarget="app-menu"
          aria-haspopup="dialog" aria-label="Open menu">
    Inkwell
    <%= inline_svg_tag "lucide/chevron-down.svg", class: "lucide app-menu-trigger__chevron", size: "16px" %>
  </button>
  <%# THE app menu (id="app-menu"): the workspace switcher. The other candidate %>
  <%# menus tried during design (hub, cards, jump-sheet) are gone — resurrect %>
  <%# from git history, don't fork a new one. %>
  <%= render "layouts/app_menu_switcher" %>
  <div class="bar__spacer"></div>

  <% if authenticated? %>
  <%= render "notifications/bell" %>

  <%# No menu/menuitem roles: that ARIA pattern promises arrow-key navigation we
      don't implement. Native popover + real buttons/links are keyboard-correct
      as-is (first rule of ARIA). %>
  <button type="button" class="avatar" popovertarget="user-menu" aria-label="Account menu"><%= avatar_content(Current.user) %></button>

  <div class="menu menu--user" popover id="user-menu">
    <button type="button" class="menu__item">My Profile</button>
    <%= link_to "Settings", user_settings_path, class: "menu__item" %>
    <hr class="menu__separator">
    <div class="menu__row">
      <button type="button" class="menu__item theme-toggle" data-mode="light"
              data-controller="theme" data-action="theme#cycle" aria-label="Theme">
        <%= inline_svg_tag "lucide/sun.svg", class: "lucide theme-toggle__icon theme-toggle__icon--light", size: "16px" %>
        <%= inline_svg_tag "lucide/moon.svg", class: "lucide theme-toggle__icon theme-toggle__icon--dark", size: "16px" %>
        <%= inline_svg_tag "lucide/monitor.svg", class: "lucide theme-toggle__icon theme-toggle__icon--auto", size: "16px" %>
        <span data-theme-target="label">Light</span>
      </button>
      <button type="button" class="menu__item tint-toggle" aria-label="Background color"
              data-controller="tint" data-tint-tints-value='["olive","taupe","mauve","mist","zinc"]'
              data-action="tint#cycle">
        <%= inline_svg_tag "lucide/droplet.svg", class: "lucide", size: "16px" %>
        <span data-tint-target="label">Zinc</span>
      </button>
    </div>
    <%= button_to "Sign out", session_path, method: :delete, class: "menu__item" %>
  </div>
  <% else %>
  <%= link_to "Sign in", new_session_path, class: "button button--ghost" %>
  <% end %>
</header>
