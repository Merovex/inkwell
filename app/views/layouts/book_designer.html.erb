<%# Full-screen shell for the SiteDesigner (docs/site-designer.md): no app
    header, no .canvas gutters — the editor owns the whole viewport, like the
    styleguide of a design tool. Same head plumbing as the application
    layout so admin tokens, importmap, and CSRF all behave identically. %>
<!DOCTYPE html>
<html lang="en" data-theme="<%= current_theme %>" data-tint="<%= current_tint %>">
  <head>
    <title><%= document_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="application-name" content="Kindred Quill">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Linked BEFORE :app so lexxy-theme.css can override the gem's :root
        variables (same order as the admin layout). The hero's "Your own
        words" editor is a Lexxy field. %>
    <%= stylesheet_link_tag "lexxy", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%# The theme's font families, so the rail's pairing cards render in
        their actual faces. Browsers fetch only the faces actually drawn. %>
    <% if @theme&.fonts_url %>
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link rel="stylesheet" href="<%= @theme.fonts_url %>">
    <% end %>
  </head>

  <body class="book-designer">
    <%= yield %>
    <%= render "layouts/toasts" %>
  </body>
</html>
