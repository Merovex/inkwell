<%# locals: (link_class:) — the public nav's page links, rendered twice by
    layouts/public: once in the desktop bar, once in the mobile menu. One
    source so the two can never drift. %>
<%= link_to "Home", root_path, class: "#{link_class}#{' is-active' if current_page?(root_path)}" %>
<%= link_to "Books", books_path, class: "#{link_class}#{' is-active' if controller_name == 'books'}" %>
<%= link_to "Blog", blog_path, class: "#{link_class}#{' is-active' if controller_name == 'blog'}" %>
<%= link_to "About", about_path, class: "#{link_class}#{' is-active' if current_page?(about_path)}" %>
