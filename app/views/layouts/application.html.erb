<!DOCTYPE html>
<html lang="en" data-theme="<%= current_theme %>" data-tint="<%= current_tint %>">
  <head>
    <title><%= document_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Kindred Quill">
    <meta name="mobile-web-app-capable" content="yes">
    <%# The app host is admin + auth — keep it out of search indexes. %>
    <meta name="robots" content="noindex">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# PWA manifest (routes enabled in config/routes.rb) — develop-as-PWA, ADR 0005. %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Lexxy editor + rendered rich-text content styles (gem asset, outside the :app bundle). %>
    <%# Linked BEFORE :app so lexxy-theme.css can override the gem's :root variables. %>
    <%= stylesheet_link_tag "lexxy", "data-turbo-track": "reload" %>
    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= "hotwire-native" if hotwire_native? %>">
    <a href="#main-content" class="u-skip-link">Skip to content</a>
    <%= render "layouts/header" %>
    <%# CANDIDATE: the Site's workspace sub-header (Basecamp page-sheet nav). %>
    <%= render "layouts/site_subnav" unless hotwire_native? %>
    <main id="main-content" class="canvas <%= yield(:canvas_class) %>"><%= yield %></main>
    <%= render "layouts/toasts" %>
  </body>
</html>
