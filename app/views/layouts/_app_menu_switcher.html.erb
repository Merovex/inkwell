<%# CANDIDATE: the "Container Switcher" (TailwindPlus flyout style — neutral, no %>
<%# accent). The global menu answers only "which container am I working in?" and %>
<%# gets you in the front door of a Site or a Circle; deep page nav lives in each %>
<%# container's own nav (the Site sub-header). One column: the single site card on %>
<%# top, circles listed below — icon-square + title + description rows — and a %>
<%# two-action footer. Circle links drop the site slug from SCRIPT_NAME. Opened by %>
<%# the brand trigger (id="app-menu"). Other candidates: _app_menu_hub, _app_menu. %>
<div class="switcher" id="app-menu" popover role="dialog" aria-label="Switch workspace">
  <% if Current.user %>
    <% sites   = Current.user.accounts.order(:name) %>
    <% site    = Current.account || sites.first %>
    <% circles = Current.user.circles.order(:name) %>

    <header class="switcher__head">
      <span class="switcher__whoami">
        <span class="avatar"><%= avatar_content(Current.user) %></span>
        <span class="switcher__name"><%= Current.user.display_name %></span>
      </span>
      <button type="button" class="switcher__close" popovertarget="app-menu"
              popovertargetaction="hide" aria-label="Close">
        <%= inline_svg_tag "lucide/circle-x.svg", class: "lucide", size: "20px" %>
      </button>
    </header>

    <div class="switcher__cols">
      <%# ── The one publishing site (0..1) ───────────────────────────────── %>
      <section class="switcher__col">
        <h3 class="switcher__label u-microcaps">Publishing site</h3>
        <% if site %>
          <%= link_to site.admin_path, class: "switcher__card" do %>
            <span class="switcher__card-icon"><%= inline_svg_tag "lucide/house.svg", class: "lucide", size: "18px" %></span>
            <span class="switcher__card-body">
              <span class="switcher__card-name"><%= site.name %></span>
              <span class="switcher__card-meta"><%= site.public_address %> • Live</span>
            </span>
          <% end %>
          <% if sites.many? %>
            <div class="switcher__switch">
              <span class="u-microcaps">Switch site</span>
              <% sites.where.not(id: site.id).each do |other| %>
                <%= link_to other.name, other.admin_path %>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <%= link_to new_account_path(script_name: ""), class: "switcher__invite" do %>
            <strong>Ready to publish publicly?</strong>
            <span>Create your site →</span>
          <% end %>
        <% end %>
      </section>

      <%# ── The many circles (0..N) ──────────────────────────────────────── %>
      <section class="switcher__col">
        <h3 class="switcher__label u-microcaps">Circles<%= " (#{circles.size})" if circles.any? %></h3>
        <% if circles.any? %>
          <% circles.first(6).each do |circle| %>
            <%= link_to circle_path(circle, script_name: ""), class: "switcher__card" do %>
              <span class="switcher__card-icon"><%= inline_svg_tag "lucide/message-square.svg", class: "lucide", size: "18px" %></span>
              <span class="switcher__card-body">
                <span class="switcher__card-name"><%= circle.name %></span>
                <span class="switcher__card-meta"><%= pluralize circle.circle_memberships.count, "member" %></span>
              </span>
            <% end %>
          <% end %>
        <% else %>
          <p class="switcher__empty">You're not in any circles yet.</p>
        <% end %>
      </section>
    </div>

    <footer class="switcher__footer">
      <span class="switcher__foot switcher__foot--soon" title="Not wired yet">
        <%= inline_svg_tag "lucide/plus.svg", class: "lucide", size: "16px" %> New circle
      </span>
      <%= link_to circles_path(script_name: ""), class: "switcher__foot" do %>
        <%= inline_svg_tag "lucide/message-square.svg", class: "lucide", size: "16px" %> All circles
      <% end %>
    </footer>
  <% end %>
</div>
