<% content_for :title, "Support desk — Inkwell" %>

<%= render "admin/shared/canvas_head", crumbs: [["Support desk", nil]] %>

<header class="perma-header">
  <h1 class="perma-header__title">Support desk</h1>
  <div class="perma-header__content">
    <nav class="perma-header__toolbar" aria-label="Ticket states">
      <% Ticket::STATUSES.each do |state| %>
        <%= link_to desk_tickets_path(state: state),
              class: "button button--small#{' button--primary' if state == @state}",
              aria: { current: ("page" if state == @state) } do %>
          <%= state.capitalize %> <span class="button__count">(<%= @counts[state].to_i %>)</span>
        <% end %>
      <% end %>
    </nav>
  </div>
</header>

<% if @tickets.any? %>
  <div class="list">
    <% @tickets.each do |ticket| %>
      <%= render "shared/list_item",
            href: ticket_path(ticket.record),
            title: ticket.title,
            avatar_user: ticket.creator,
            author: ticket.creator.display_name,
            date: ticket.created_at.strftime("%b %-d, %Y"),
            comment_count: ticket.record.comments.size %>
    <% end %>
  </div>
<% else %>
  <div class="empty">
    <span class="empty__icon"><%= inline_svg_tag "lucide/inbox.svg", class: "lucide", size: "40px" %></span>
    <p class="empty__title">No <%= @state %> tickets</p>
    <p class="empty__text">Quiet desk. Enjoy it while it lasts.</p>
  </div>
<% end %>
