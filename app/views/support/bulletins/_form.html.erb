<%# locals: (bulletin:, url:) %>
<%= render "admin/shared/error_summary", model: bulletin %>

<%# The posts composer, slimmed: title + body, submits from the canvas-head
    buttons (form: "composer"). %>
<%= form_with model: bulletin, url: url, id: "composer", class: "composer" do |f| %>
  <%= f.text_field :title, class: "composer__title", placeholder: "Bulletin title",
        "aria-label": "Title", required: true, autofocus: true %>

  <%= f.rich_textarea :content, placeholder: "What's changing…", "aria-label": "Body" %>
<% end %>
