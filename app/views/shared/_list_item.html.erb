<%# locals: (title:, href: nil, title_tag: "h3", author: nil, date: nil, excerpt: nil, avatar: true, avatar_user: nil, avatar_src: nil, avatar_alt: "", avatar_initials: nil, avatar_spacer: false, chips: [], badge: nil, badge_variant: nil, client_visible: false, comment_count: 0, scheduled_at: nil, pinned: false, activity: nil, actions: nil, discard_path: nil, discard_confirm: nil, discard_title: "Delete", discard_aria: nil) %>
<%# THE list row. Every .list renders its rows through this partial — never %>
<%# hand-roll .list__item markup (see CLAUDE.md "List rows"). %>
<%# Structure: avatar + (heading title + meta) + optional trailing count/actions. %>
<%# The title is a real heading (h3 by default). When href is given the whole %>
<%# middle column is the link — a.list__body wraps title + meta, and its %>
<%# ::after stretches the click target over the row. Without href the body %>
<%# is a plain div (missives, subscribers, stat rows). %>
<%# title_tag: heading tag for the title ("h3" default; "span" for compact %>
<%# stat rows where a heading per row would be noise). %>
<%# avatar_src takes a raw image (e.g. a book cover); avatar_user renders that %>
<%# user's picture-or-monogram; otherwise initials derive from avatar_initials %>
<%# (e.g. the book title) or, failing that, the author string. avatar: false %>
<%# drops the avatar column entirely (settings-style lists); avatar_spacer: true %>
<%# keeps the indent with no avatar (a row that isn't a person's — e.g. a pulse). %>
<%# author/date are optional — a blank byline collapses, leaving just the excerpt. %>
<%# chips replace the author in the byline (e.g. a book's series). %>
<%# badge puts a pill next to the title (badge_variant: "accent"/"warning"). %>
<%# scheduled_at adds a "Posts on <time>" clock flag; pinned adds a "Pinned" flag. %>
<%# actions: captured HTML for the far-right action zone (buttons, stat badges). %>
<%# discard_path adds a far-right trashcan (DELETE, with discard_confirm prompt); %>
<%# discard_title/discard_aria relabel it (e.g. "Remove", "Trash"). %>
<article class="list__item">
  <% if avatar_spacer %>
    <span class="list__avatar-spacer" aria-hidden="true"></span>
  <% elsif avatar %>
    <span class="avatar list__avatar">
      <% if avatar_src.present? %>
        <%= image_tag avatar_src, alt: avatar_alt, class: "avatar__img" %>
      <% elsif avatar_user %>
        <%= avatar_content(avatar_user) %>
      <% else %>
        <%= (avatar_initials.presence || author).to_s.split.map { |w| w[0] }.first(2).join.upcase %>
      <% end %>
    </span>
  <% end %>

  <%= content_tag (href ? :a : :div), href: href, class: "list__body" do %>
    <div class="list__titlerow">
      <%= content_tag title_tag, title, class: "list__title" %>
      <% if badge.present? %>
        <span class="badge<%= " badge--#{badge_variant}" if badge_variant %>"><%= badge %></span>
      <% end %>
      <% if client_visible %>
        <span class="badge badge--warning"><%= inline_svg_tag "lucide/eye.svg", class: "lucide", size: "14px" %> Client visible</span>
      <% end %>
    </div>
    <% label = chips.any? ? safe_join(chips.map { |chip| tag.span(chip, class: "badge badge--accent") }, " ") : author %>
    <% byline = safe_join([ label.presence, date.presence ].compact, " · ") %>
    <% if byline.present? || excerpt.present? %>
      <span class="list__meta u-clamp"><% if byline.present? %><span class="list__byline"><%= byline %></span> <% end %><%= excerpt %></span>
    <% end %>
    <% if scheduled_at %>
      <span class="list__flag">
        <%= inline_svg_tag "lucide/clock.svg", class: "lucide", size: "14px" %>
        Posts on
        <time datetime="<%= scheduled_at.iso8601 %>" data-controller="local-time"
              data-local-time-datetime-value="<%= scheduled_at.iso8601 %>"><%= scheduled_at.strftime("%b %-d at %H:%M") %></time>
      </span>
    <% end %>
    <% if pinned %>
      <span class="list__flag">
        <%= inline_svg_tag "lucide/pin.svg", class: "lucide", size: "14px" %>
        Pinned
      </span>
    <% end %>
    <%# activity: a captured staleness row under the excerpt — e.g. a
        discussion's "3 comments [avatars] · 2 hours ago". %>
    <% if activity.present? %>
      <span class="list__activity"><%= activity %></span>
    <% end %>
  <% end %>

  <% if comment_count.to_i.positive? %>
    <span class="list__count" aria-label="<%= comment_count %> comments"><%= comment_count %></span>
  <% end %>

  <% if actions.present? %>
    <span class="list__action"><%= actions %></span>
  <% end %>

  <% if discard_path %>
    <%= button_to discard_path, method: :delete, form_class: "list__action",
          class: "button button--icon button--ghost", title: discard_title,
          "aria-label": discard_aria || discard_title,
          form: { data: { turbo_confirm: discard_confirm } } do %>
      <%= inline_svg_tag "lucide/trash-2.svg", class: "lucide", size: "16px" %>
    <% end %>
  <% end %>
</article>
