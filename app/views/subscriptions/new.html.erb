<% content_for :title, "Newsletter — #{site_settings.site_name}" %>

<section class="press-shell">
  <header class="press-header u-flow u-flow-half">
    <h1 class="press-display-lg">Join the newsletter</h1>
    <p class="press-muted">New releases and dispatches from <%= site_settings.site_name %>. No spam; unsubscribe anytime.</p>
  </header>

  <%# The author's invitation, from the newsletter Page (/admin/pages/newsletter) —
      the same copy the static build renders above the signup band. %>
  <% if (invitation = site_page("newsletter"))&.content.present? %>
    <div class="press-body prose"><%= invitation.content %></div>
  <% end %>

  <% if flash[:notice] %>
    <p class="press-form__flash press-form__flash--notice"><%= flash[:notice] %></p>
  <% elsif flash[:alert] %>
    <p class="press-form__flash press-form__flash--alert"><%= flash[:alert] %></p>
  <% end %>

  <%= form_with url: newsletter_path, method: :post, class: "press-form" do %>
    <%# Pinned honeypot — invisible to humans, enticing to bots; a filled value
        is silently discarded. The same fixed field the static form bakes in
        (Subscriber::HONEYPOT_FIELD), out of AT and the tab order. %>
    <div class="u-visually-hidden" aria-hidden="true">
      <label for="<%= Subscriber::HONEYPOT_FIELD %>">Leave this field empty</label>
      <%= text_field_tag Subscriber::HONEYPOT_FIELD, nil, tabindex: -1, autocomplete: "off" %>
    </div>
    <%= hidden_field_tag :source, params[:source] || "newsletter_page" %>
    <label class="press-form__label" for="email_address">Email address</label>
    <div class="press-form__row">
      <%= email_field_tag :email_address, params[:email_address], required: true,
            placeholder: "you@example.com", class: "press-form__input", autocomplete: "email" %>
      <%= submit_tag "Subscribe", class: "press-btn press-btn--primary" %>
    </div>
    <% if (turnstile_site_key = TurnstileVerifier.site_key_for(Current.account)) %>
      <div class="cf-turnstile" data-sitekey="<%= turnstile_site_key %>"></div>
      <% content_for :head do %>
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
      <% end %>
    <% end %>
  <% end %>
</section>
