<%= @drop.body %>

<% if @magnet %>
  <p style="margin: 24px 0;">
    <a href="<%= @claim_url %>"
       style="display: inline-block; padding: 12px 24px; background: #1a1a1a; color: #ffffff; text-decoration: none; border-radius: 6px;">
      Get <%= @magnet.title %>
    </a>
  </p>
<% end %>

<hr>

<p style="color: #888; font-size: 12px;">
  You're receiving this because you subscribed to <%= @site_name %>.
  <%= link_to "Unsubscribe", @unsubscribe_url %>.
</p>
