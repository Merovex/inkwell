{{/* About page from site.json's description_html. */}}
{{ $data := hugo.Data.site }}
{{ if ne (int ($data.contract_version | default 0)) (int hugo.Data.theme.contract_version) }}
  {{ errorf "site.json: theme expects contract_version %v, got %v" hugo.Data.theme.contract_version $data.contract_version }}
{{ end }}
{{ $.AddPage (dict
    "path" "about"
    "title" (printf "About %s" $data.name)
    "content" (dict "mediaType" "text/html" "value" $data.description_html)
) }}

{{/* Standalone signup page at /newsletter — the band as a destination.
     Pre-cutover Rails served a signup page here, so old links and typed
     URLs keep working. Renders the same sections/newsletter.html partial
     as the home band: the real form when the contract carries a signup
     block, the mailto CTA otherwise. */}}
{{ $.AddPage (dict
    "path" "newsletter"
    "title" (printf "Join the newsletter — %s" $data.name)
    "layout" "newsletter"
) }}
